#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
runner="$script_dir/ask-tmux-pipeline"
if [[ ! -x "$runner" ]]; then
  runner="$(command -v ask-tmux-pipeline 2>/dev/null || true)"
fi
if [[ -z "$runner" || ! -x "$runner" ]]; then
  printf 'ask-tmux-pipeline is not installed or executable on this machine\n' >&2
  exit 127
fi

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  exec "$runner" --help
fi

case "$cmd" in
  start)
    shift || true
    exec "$runner" "$cmd" --provider claude --mode mirror "$@"
    ;;
  answer|review|status|resume|final-context|doctor|-h|--help|help)
    shift || true
    exec "$runner" "$cmd" --provider claude "$@"
    ;;
  --*)
    exec "$runner" start --provider claude --mode mirror "$@"
    ;;
  *)
    exec "$runner" start --provider claude --mode mirror "$@"
    ;;
esac
