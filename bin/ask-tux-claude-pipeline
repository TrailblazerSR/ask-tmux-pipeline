#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
target="$script_dir/ask-tmux-claude-pipeline"
if [[ ! -x "$target" ]]; then
  target="$(command -v ask-tmux-claude-pipeline 2>/dev/null || true)"
fi
if [[ -z "$target" || ! -x "$target" ]]; then
  printf 'ask-tmux-claude-pipeline is not installed or executable on this machine\n' >&2
  exit 127
fi

exec "$target" "$@"
