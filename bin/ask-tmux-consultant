#!/usr/bin/env bash
set -euo pipefail

for ask_tmux_path_entry in \
  /opt/homebrew/opt/coreutils/libexec/gnubin \
  /usr/local/opt/coreutils/libexec/gnubin \
  "$HOME/.local/bin" \
  "$HOME/bin" \
  /opt/homebrew/bin \
  /opt/homebrew/sbin \
  /usr/local/bin \
  /usr/local/sbin; do
  if [[ -d "$ask_tmux_path_entry" ]]; then
    PATH="$ask_tmux_path_entry:$PATH"
  fi
done
for ask_tmux_path_entry in "$HOME"/.nvm/versions/node/*/bin; do
  if [[ -d "$ask_tmux_path_entry" ]]; then
    PATH="$ask_tmux_path_entry:$PATH"
  fi
done
export PATH

if ! command -v rg >/dev/null 2>&1; then
  ASK_TMUX_RG_FALLBACK=grep
  rg() {
    local fixed=false quiet=false line_numbers=false recursive=false pattern target
    local flags=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -Fq|-qF) fixed=true; quiet=true; shift ;;
        -F) fixed=true; shift ;;
        -q) quiet=true; shift ;;
        -n) line_numbers=true; shift ;;
        --) shift; break ;;
        -*) printf 'rg fallback unsupported option: %s\n' "$1" >&2; return 2 ;;
        *) break ;;
      esac
    done
    [[ $# -ge 1 ]] || { printf 'rg fallback requires a pattern\n' >&2; return 2; }
    pattern="$1"
    shift
    for target in "$@"; do
      [[ -d "$target" ]] && recursive=true
    done
    if [[ "$fixed" == "true" ]]; then flags+=("-F"); else flags+=("-E"); fi
    [[ "$quiet" == "true" ]] && flags+=("-q")
    [[ "$line_numbers" == "true" ]] && flags+=("-n")
    [[ "$recursive" == "true" ]] && flags+=("-R")
    grep "${flags[@]}" -- "$pattern" "$@"
  }
fi

VERSION="0.4.2"
ASK_TMUX_STATE_HOME="${ASK_TMUX_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/ask-tmux}"
STATE_ROOT="${ASK_TMUX_STATE_ROOT:-$ASK_TMUX_STATE_HOME/consultants}"
LEGACY_STATE_ROOT="$HOME/.omx/state/consultants"
ARTIFACT_ROOT="${ASK_TMUX_ARTIFACT_ROOT:-$ASK_TMUX_STATE_HOME/artifacts/consultants}"
LOG_PATH="${ASK_TMUX_LOG_PATH:-$ASK_TMUX_STATE_HOME/consultants/log.jsonl}"
PROJECT_ARTIFACT_DIR="${ASK_TMUX_PROJECT_ARTIFACT_DIR:-.ask-tmux}"
PACKET_LIMIT_BYTES="${ASK_TMUX_PACKET_LIMIT_BYTES:-65536}"
READY_TIMEOUT_SECONDS="${ASK_TMUX_READY_TIMEOUT_SECONDS:-45}"
WAIT_TIMEOUT_SECONDS="${ASK_TMUX_WAIT_TIMEOUT_SECONDS:-600}"
DEFAULT_CLAUDE_EFFORT="${ASK_TMUX_CLAUDE_EFFORT:-high}"
CLAUDE_524_MAX_RETRIES="${ASK_TMUX_CLAUDE_524_MAX_RETRIES:-2}"
CLAUDE_524_BACKOFF_SECONDS="${ASK_TMUX_CLAUDE_524_BACKOFF_SECONDS:-120}"
RESPONSE_CHUNK_WORDS="${ASK_TMUX_RESPONSE_CHUNK_WORDS:-900}"
SCOPE_MAX_REVISIONS="${ASK_TMUX_SCOPE_MAX_REVISIONS:-3}"
CLAUDE_RUNTIME_FLAGS="--bare --disable-slash-commands --no-chrome --dangerously-skip-permissions"

usage() {
  cat <<'USAGE'
ask-tmux-consultant <command> [options]

Commands:
  send      Create a packet and send a prompt to a reusable tmux consultant
  status    Show consultant session state
  capture   Capture consultant tmux pane output
  attach    Print or run tmux attach for a consultant session
  release   Kill managed consultant tmux session(s)
  cleanup   Release stale managed consultant sessions
  gc        Alias for cleanup
  preflight Run a read-only caller-context tmux control probe
  doctor    Check tmux, provider CLI, runner helpers, and state paths

Common options:
  --provider claude|codex
  --model MODEL             Optional Claude model pin. Supported only with cc-claude.
  --effort LEVEL            Optional Claude effort: low, medium, high, xhigh, or max.
  --key NAME
  --cwd PATH
  --cwd-mode project|parent|git|current
  --materials PATH|-       Repeatable. Directories are listed, small files/stdin are embedded.
  --prompt TEXT
  --task review|comment|plan|debug|custom
  --fresh                  Refuse if a same-key live session exists unless --replace is also set.
  --replace                With --fresh, release the same-key live session before launching.
  --reuse                  Reuse same-key live session. Default for send.
  --stub                   Launch a no-cost shell stub instead of Claude/Codex.
  --wait / --no-wait       Wait for done sentinel and print response file. Default: wait.
  --wait-timeout SECONDS
  --ready-timeout SECONDS
  --auto-trust             Press Enter on Claude/Codex workspace trust prompt.
  --dry-run
  --all                    For status/release.
  --stale-after DURATION   For cleanup, e.g. 24h, 30m, 3600s.
USAGE
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'WARN: %s\n' "$*" >&2
}

info() {
  printf '%s\n' "$*"
}

fail_outcome() {
  local kind="$1" retryable="$2"
  shift 2
  printf 'ASK_TMUX_OUTCOME=%s\n' "$kind" >&2
  printf 'ASK_TMUX_RETRYABLE=%s\n' "$retryable" >&2
  die "$*"
}

tmux_binary() {
  local configured="${ASK_TMUX_TMUX_BIN:-}"
  if [[ -n "$configured" ]]; then
    if [[ -x "$configured" ]]; then
      printf '%s\n' "$configured"
      return 0
    fi
    return 1
  fi
  type -P tmux 2>/dev/null
}

tmux() {
  local binary
  binary="$(tmux_binary)" || return 127
  command "$binary" "$@"
}

tmux_preflight_json() {
  local binary
  binary="$(tmux_binary 2>/dev/null || true)"
  python3 - "$binary" <<'PY'
import json
import os
import socket
import subprocess
import sys

binary = sys.argv[1].strip()
record = {
    "schema": "ask_tmux_preflight.v1",
    "status": "blocked",
    "phase": "tmux_control",
    "kind": "tmux_client_missing",
    "blocking": True,
    "retryable": False,
    "command_exit": 127,
    "stdout": "",
    "stderr": "tmux is not installed or executable",
    "caller": {
        "host": socket.gethostname(),
        "uid": os.getuid() if hasattr(os, "getuid") else None,
        "pid": os.getpid(),
        "cwd": os.getcwd(),
    },
    "tmux": {
        "binary": binary,
        "version": "",
    },
}

if not binary:
    print(json.dumps(record, sort_keys=True))
    raise SystemExit(1)

try:
    version_run = subprocess.run(
        [binary, "-V"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
except (OSError, subprocess.SubprocessError) as exc:
    record["kind"] = "tmux_client_missing"
    record["stderr"] = str(exc)[:2000]
    print(json.dumps(record, sort_keys=True))
    raise SystemExit(1)

record["tmux"]["version"] = (
    version_run.stdout.strip() or version_run.stderr.strip()
)[:500]
if version_run.returncode != 0:
    record["kind"] = "tmux_control_failed"
    record["command_exit"] = int(version_run.returncode)
    record["stderr"] = version_run.stderr.strip()[:2000]
    print(json.dumps(record, sort_keys=True))
    raise SystemExit(1)

try:
    probe = subprocess.run(
        [binary, "list-sessions", "-F", "#{session_name}"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
except subprocess.TimeoutExpired as exc:
    record.update(
        {
            "kind": "tmux_control_failed",
            "retryable": True,
            "command_exit": 124,
            "stderr": f"tmux control probe timed out: {exc}"[:2000],
        }
    )
    print(json.dumps(record, sort_keys=True))
    raise SystemExit(1)
except OSError as exc:
    record.update(
        {
            "kind": "tmux_client_missing",
            "command_exit": 127,
            "stderr": str(exc)[:2000],
        }
    )
    print(json.dumps(record, sort_keys=True))
    raise SystemExit(1)

stdout = probe.stdout.strip()[:4000]
stderr = probe.stderr.strip()[:4000]
detail = f"{stderr}\n{stdout}".lower()
record["command_exit"] = int(probe.returncode)
record["stdout"] = stdout
record["stderr"] = stderr

if probe.returncode == 0:
    record.update(
        {
            "status": "ready",
            "kind": "tmux_control_ready",
            "blocking": False,
            "retryable": False,
        }
    )
elif any(
    marker in detail
    for marker in ("operation not permitted", "permission denied", "access denied")
):
    record.update(
        {
            "kind": "tmux_socket_denied",
            "blocking": True,
            "retryable": False,
        }
    )
elif "protocol version mismatch" in detail or (
    "protocol" in detail and "mismatch" in detail
):
    record.update(
        {
            "kind": "tmux_protocol_mismatch",
            "blocking": True,
            "retryable": False,
        }
    )
elif "no server running" in detail or (
    "error connecting to" in detail and "no such file or directory" in detail
):
    record.update(
        {
            "status": "ready",
            "kind": "tmux_server_absent",
            "blocking": False,
            "retryable": True,
        }
    )
else:
    record.update(
        {
            "kind": "tmux_control_failed",
            "blocking": True,
            "retryable": True,
        }
    )

print(json.dumps(record, sort_keys=True))
raise SystemExit(1 if record["blocking"] else 0)
PY
}

preflight_json_field() {
  local record="$1" field="$2"
  python3 - "$record" "$field" <<'PY'
import json
import sys

value = json.loads(sys.argv[1])
for part in sys.argv[2].split("."):
    if not isinstance(value, dict):
        value = None
        break
    value = value.get(part)
if isinstance(value, bool):
    print("true" if value else "false")
elif value is not None:
    print(value)
PY
}

TMUX_CONTROL_COMMAND=""
TMUX_CONTROL_EXIT=0
TMUX_CONTROL_STDOUT=""
TMUX_CONTROL_STDERR=""
TMUX_CONTROL_KIND=""
TMUX_CONTROL_RETRYABLE="true"
TMUX_RESOLVED_PANE=""
TMUX_CAPTURE_TEXT=""
TMUX_PROMPT_DELIVERY_PHASE=""

classify_tmux_control_failure() {
  local detail
  detail="$(
    printf '%s\n%s\n' "$TMUX_CONTROL_STDERR" "$TMUX_CONTROL_STDOUT" \
      | tr '[:upper:]' '[:lower:]'
  )"
  case "$detail" in
    *"operation not permitted"*|*"permission denied"*|*"access denied"*)
      TMUX_CONTROL_KIND="tmux_socket_denied"
      TMUX_CONTROL_RETRYABLE="false"
      ;;
    *"protocol version mismatch"*|*"protocol"*"mismatch"*)
      TMUX_CONTROL_KIND="tmux_protocol_mismatch"
      TMUX_CONTROL_RETRYABLE="false"
      ;;
    *"can't find pane"*|*"no such pane"*)
      TMUX_CONTROL_KIND="tmux_pane_missing"
      TMUX_CONTROL_RETRYABLE="true"
      ;;
    *)
      if [[ "$TMUX_CONTROL_EXIT" == "127" ]]; then
        TMUX_CONTROL_KIND="tmux_client_missing"
        TMUX_CONTROL_RETRYABLE="false"
      else
        TMUX_CONTROL_KIND="tmux_control_failed"
        TMUX_CONTROL_RETRYABLE="true"
      fi
      ;;
  esac
}

tmux_control_command() {
  local stderr_file
  TMUX_CONTROL_COMMAND="${1:-tmux}"
  TMUX_CONTROL_EXIT=0
  TMUX_CONTROL_STDOUT=""
  TMUX_CONTROL_STDERR=""
  TMUX_CONTROL_KIND=""
  TMUX_CONTROL_RETRYABLE="true"
  stderr_file="$(mktemp "${TMPDIR:-/tmp}/ask-tmux-control.XXXXXX")"
  if TMUX_CONTROL_STDOUT="$(tmux "$@" 2>"$stderr_file")"; then
    TMUX_CONTROL_EXIT=0
  else
    TMUX_CONTROL_EXIT="$?"
  fi
  TMUX_CONTROL_STDERR="$(sed -n '1,200p' "$stderr_file")"
  rm -f "$stderr_file"
  if [[ "$TMUX_CONTROL_EXIT" == "0" ]]; then
    return 0
  fi
  classify_tmux_control_failure
  return 1
}

tmux_session_liveness() {
  local session="$1"
  if tmux_control_command has-session -t "$session"; then
    return 0
  fi
  if tmux_control_confirms_session_absence; then
    return 1
  fi
  return 2
}

tmux_control_confirms_session_absence() {
  local detail
  detail="$(
    printf '%s\n%s\n' "$TMUX_CONTROL_STDERR" "$TMUX_CONTROL_STDOUT" \
      | tr '[:upper:]' '[:lower:]'
  )"
  case "$detail" in
    *"can't find session"*|*"no such session"*|*"no server running"*|*"no sessions"*|*"error connecting to"*"no such file or directory"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

capture_pane_text_checked() {
  local pane="$1" lines="${2:-120}"
  TMUX_CAPTURE_TEXT=""
  if tmux_control_command capture-pane -J -t "$pane" -p -S "-$lines"; then
    TMUX_CAPTURE_TEXT="$TMUX_CONTROL_STDOUT"
    return 0
  fi
  return 2
}

kill_tmux_session_checked() {
  local session="$1" liveness_status
  if tmux_session_liveness "$session"; then
    :
  else
    liveness_status="$?"
    [[ "$liveness_status" == "1" ]] && return 1
    return 2
  fi
  if tmux_control_command kill-session -t "$session"; then
    return 0
  fi
  if tmux_control_confirms_session_absence; then
    return 1
  fi
  return 2
}

pane_target_for_session_checked() {
  local session="$1" preferred_pane="${2:-}"
  TMUX_RESOLVED_PANE=""
  if [[ -n "$preferred_pane" ]]; then
    if tmux_control_command display-message -p -t "$preferred_pane" '#{pane_id}'; then
      TMUX_RESOLVED_PANE="$preferred_pane"
      return 0
    fi
    if [[ "$TMUX_CONTROL_KIND" != "tmux_pane_missing" ]]; then
      return 2
    fi
  fi
  if ! tmux_control_command list-panes -t "$session" -F '#{pane_id}'; then
    return 2
  fi
  TMUX_RESOLVED_PANE="$(printf '%s\n' "$TMUX_CONTROL_STDOUT" | sed -n '1p')"
  [[ -n "$TMUX_RESOLVED_PANE" ]] || return 1
  return 0
}

tmux_control_report() {
  local outcome_kind="$1" retryable="$2"
  TMUX_REPORT_OUTCOME="$outcome_kind" \
  TMUX_REPORT_RETRYABLE="$retryable" \
  TMUX_REPORT_COMMAND="$TMUX_CONTROL_COMMAND" \
  TMUX_REPORT_CONTROL_KIND="$TMUX_CONTROL_KIND" \
  TMUX_REPORT_EXIT="$TMUX_CONTROL_EXIT" \
  TMUX_REPORT_STDOUT="$TMUX_CONTROL_STDOUT" \
  TMUX_REPORT_STDERR="$TMUX_CONTROL_STDERR" \
    python3 - <<'PY'
import json
import os

def bounded(name):
    return os.environ.get(name, "")[:4000]

print(json.dumps({
    "schema": "ask_tmux_runtime_control.v1",
    "phase": "tmux_control_runtime",
    "kind": bounded("TMUX_REPORT_OUTCOME"),
    "control_kind": bounded("TMUX_REPORT_CONTROL_KIND"),
    "retryable": bounded("TMUX_REPORT_RETRYABLE") == "true",
    "command": bounded("TMUX_REPORT_COMMAND"),
    "command_exit": int(os.environ.get("TMUX_REPORT_EXIT", "1")),
    "stdout": bounded("TMUX_REPORT_STDOUT"),
    "stderr": bounded("TMUX_REPORT_STDERR"),
}, sort_keys=True))
PY
}

fail_tmux_control() {
  local outcome_kind="$1" retryable="$2"
  shift 2
  printf 'ASK_TMUX_OUTCOME=%s\n' "$outcome_kind" >&2
  printf 'ASK_TMUX_RETRYABLE=%s\n' "$retryable" >&2
  tmux_control_report "$outcome_kind" "$retryable" >&2
  die "$*"
}

runtime_tmux_outcome_kind() {
  case "$TMUX_CONTROL_KIND" in
    tmux_socket_denied) printf '%s\n' "tmux_runtime_socket_denied" ;;
    tmux_protocol_mismatch) printf '%s\n' "tmux_runtime_protocol_mismatch" ;;
    tmux_client_missing) printf '%s\n' "tmux_runtime_client_missing" ;;
    tmux_pane_missing) printf '%s\n' "tmux_pane_missing" ;;
    *) printf '%s\n' "tmux_runtime_control_failed" ;;
  esac
}

attach_tmux_session() {
  local session="$1" output_label="${2:-}" binary
  binary="$(tmux_binary)" || fail_outcome "tmux_client_missing" "false" \
    "tmux is not installed or executable"
  if [[ -t 1 ]]; then
    exec "$binary" attach -t "$session"
  fi
  if [[ -n "$output_label" ]]; then
    info "$output_label=$binary attach -t $session"
  else
    info "$binary attach -t $session"
  fi
}

json_escape() {
  if command -v python3 >/dev/null 2>&1; then
    JSON_VALUE="$1" python3 - <<'PY'
import json
import os
import sys

sys.stdout.write(json.dumps(os.environ.get("JSON_VALUE", ""))[1:-1])
PY
  else
    printf '%s' "$1" | sed ':a;N;$!ba; s/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
  fi
}

shell_quote() {
  local value="$1"
  printf "'"
  printf '%s' "$value" | sed "s/'/'\\\\''/g"
  printf "'"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g' \
    | cut -c1-64
}

short_hash() {
  printf '%s' "$1" | sha1sum | awk '{print substr($1,1,8)}'
}

key_id_from_key() {
  local key="$1" base hash
  base="$(slugify "$key")"
  [[ -n "$base" ]] || base="default"
  hash="$(short_hash "$key")"
  printf '%s-%s\n' "$(printf '%s' "$base" | cut -c1-55)" "$hash"
}

legacy_key_slug_from_key() {
  local key="$1" base
  base="$(slugify "$key")"
  [[ -n "$base" ]] || base="default"
  printf '%s\n' "$base"
}

project_slug_from_path() {
  local resolved="$1" base hash
  base="$(slugify "$(basename "$resolved")")"
  [[ -n "$base" ]] || base="root"
  hash="$(short_hash "$resolved")"
  printf '%s-%s\n' "$base" "$hash"
}

duration_to_seconds() {
  local value="$1"
  case "$value" in
    *h) printf '%s\n' "$(( ${value%h} * 3600 ))" ;;
    *m) printf '%s\n' "$(( ${value%m} * 60 ))" ;;
    *s) printf '%s\n' "${value%s}" ;;
    '' ) printf '86400\n' ;;
    *[!0-9]* ) die "invalid duration: $value" ;;
    * ) printf '%s\n' "$value" ;;
  esac
}

invoked_provider() {
  case "$(basename "$0")" in
    ask-tmux-claude|ask-tux-claude) printf 'claude\n' ;;
    ask-tmux-codex) printf 'codex\n' ;;
    *) printf '\n' ;;
  esac
}

find_project_root() {
  local start="$1"
  local dir
  dir="$(realpath -m "$start")"
  while true; do
    for marker in AGENTS.md CLAUDE.md .git .bioagent pyproject.toml package.json; do
      if [[ -e "$dir/$marker" ]]; then
        printf '%s\n' "$dir"
        return
      fi
    done
    [[ "$dir" == "/" ]] && break
    dir="$(dirname "$dir")"
  done
  realpath -m "$start"
}

first_material_base() {
  local material
	  for material in "$@"; do
	    [[ "$material" == "-" ]] && continue
	    if [[ -d "$material" ]]; then
	      realpath -m "$material"
	      return
	    fi
    if [[ -e "$material" ]]; then
      dirname "$(realpath -m "$material")"
      return
    fi
  done
  pwd
}

resolve_cwd() {
  local explicit_cwd="$1"
  local mode="$2"
  shift 2
  local base root parent git_root
  if [[ -n "$explicit_cwd" ]]; then
    base="$(realpath -m "$explicit_cwd")"
  else
    base="$(first_material_base "$@")"
  fi

  case "$mode" in
    current)
      if [[ -n "$explicit_cwd" ]]; then
        root="$base"
      else
        root="$(pwd)"
      fi
      ;;
    git)
      if git_root="$(git -C "$base" rev-parse --show-toplevel 2>/dev/null)"; then
        root="$git_root"
      else
        root="$(find_project_root "$base")"
      fi
      ;;
    parent|project)
      root="$(find_project_root "$base")"
      ;;
    *)
      die "unknown --cwd-mode: $mode"
      ;;
  esac

  if [[ "$mode" == "parent" ]]; then
    parent="$(dirname "$root")"
    if [[ "$parent" == "$root" ]]; then
      warn "cannot use parent of $root; using $root"
    else
      root="$parent"
    fi
  fi
  realpath -m "$root"
}

template_prompt() {
  local task="$1"
	  case "$task" in
	    review)
	      printf 'Review, comment, and suggest. Return verdict, high/medium/low findings with evidence, missing verification, risks, concrete suggestions, and prioritized next actions.'
      ;;
    comment)
      printf 'Comment on the supplied material. Focus on correctness, assumptions, gaps, risks, and concise actionable suggestions.'
      ;;
    plan)
      printf 'Assess the plan. Challenge scope, lifecycle, risks, alternatives, acceptance criteria, and verification before implementation.'
      ;;
    debug)
      printf 'Debug or diagnose the supplied issue. Identify likely root causes, evidence needed, safe probes, and next actions. Stay read-only unless explicitly authorized.'
      ;;
    custom)
      printf 'Follow the owner prompt in the packet. Preserve the safety boundary.'
      ;;
    *)
      die "unknown --task: $task"
      ;;
  esac
}

state_file_for() {
  local provider="$1" project_slug="$2" key_id="$3"
  printf '%s/%s/%s/%s.json\n' "$STATE_ROOT" "$provider" "$project_slug" "$key_id"
}

write_state() {
  local file="$1" provider="$2" key="$3" project_slug="$4" session="$5" pane="$6" cwd="$7" packet="$8" status="$9" release_policy="${10}" ttl="${11:-}" response_path="${12:-}" busy="${13:-false}" started_epoch="${14:-}" completed_epoch="${15:-}" done_sentinel="${16:-}" requested_model="${17:-}" claude_launcher="${18:-}" claude_effort="${19:-}"
  local now epoch tmp completed_value
  if [[ -f "$file" ]]; then
    [[ $# -ge 17 ]] || requested_model="$(read_json_field "$file" requested_model)"
    [[ $# -ge 18 ]] || claude_launcher="$(read_json_field "$file" claude_launcher)"
    [[ $# -ge 19 ]] || claude_effort="$(read_json_field "$file" claude_effort)"
  fi
  now="$(date -Is)"
  epoch="$(date +%s)"
  [[ -n "$started_epoch" ]] || started_epoch="$epoch"
  if [[ -n "$completed_epoch" ]]; then
    completed_value="$completed_epoch"
  else
    completed_value="null"
  fi
  mkdir -p "$(dirname "$file")"
  tmp="${file}.$$.$RANDOM.tmp"
  {
    printf '{\n'
    printf '  "schema": "ask_tmux_consultant.v1",\n'
    printf '  "provider": "%s",\n' "$(json_escape "$provider")"
    printf '  "key": "%s",\n' "$(json_escape "$key")"
    printf '  "project_slug": "%s",\n' "$(json_escape "$project_slug")"
    printf '  "session_name": "%s",\n' "$(json_escape "$session")"
    printf '  "pane_target": "%s",\n' "$(json_escape "$pane")"
    printf '  "cwd": "%s",\n' "$(json_escape "$cwd")"
    printf '  "cwd_resolved": "%s",\n' "$(json_escape "$(realpath -m "$cwd")")"
    printf '  "last_packet": "%s",\n' "$(json_escape "$packet")"
    printf '  "last_response": "%s",\n' "$(json_escape "$response_path")"
    printf '  "done_sentinel": "%s",\n' "$(json_escape "$done_sentinel")"
    printf '  "requested_model": "%s",\n' "$(json_escape "$requested_model")"
    printf '  "claude_launcher": "%s",\n' "$(json_escape "$claude_launcher")"
    printf '  "claude_effort": "%s",\n' "$(json_escape "$claude_effort")"
    printf '  "release_policy": "%s",\n' "$(json_escape "$release_policy")"
    printf '  "ttl": "%s",\n' "$(json_escape "$ttl")"
    printf '  "status": "%s",\n' "$(json_escape "$status")"
    printf '  "busy": %s,\n' "$busy"
    printf '  "started_epoch": %s,\n' "$started_epoch"
    printf '  "completed_epoch": %s,\n' "$completed_value"
    printf '  "last_used_epoch": %s,\n' "$epoch"
    printf '  "updated_at": "%s"\n' "$(json_escape "$now")"
    printf '}\n'
  } > "$tmp"
  mv "$tmp" "$file"
}

read_json_field() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || return 0
  python3 - "$file" "$field" <<'PY'
import json
import sys

path, field = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as handle:
        value = json.load(handle).get(field)
except Exception:
    value = None
if isinstance(value, str):
    sys.stdout.write(value)
elif value is not None:
    sys.stdout.write(str(value))
PY
}

read_json_number() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || return 0
  python3 - "$file" "$field" <<'PY'
import json
import sys

path, field = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as handle:
        value = json.load(handle).get(field)
except Exception:
    value = None
if isinstance(value, (int, float)) and not isinstance(value, bool):
    sys.stdout.write(str(int(value)))
PY
}

read_json_bool() {
  local file="$1" field="$2"
  [[ -f "$file" ]] || return 0
  python3 - "$file" "$field" <<'PY'
import json
import sys

path, field = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as handle:
        value = json.load(handle).get(field)
except Exception:
    value = None
if isinstance(value, bool):
    sys.stdout.write("true" if value else "false")
PY
}

response_file_is_fresh() {
  local response_path="$1" min_response_epoch="${2:-0}" mtime
  [[ -f "$response_path" ]] || return 1
  [[ "$min_response_epoch" =~ ^[0-9]+$ ]] || min_response_epoch=0
  mtime="$(stat -c %Y "$response_path" 2>/dev/null || printf 0)"
  [[ "$mtime" =~ ^[0-9]+$ ]] || mtime=0
  (( mtime >= min_response_epoch ))
}

response_file_is_complete() {
  local response_path="$1" completion_marker="$2" min_response_epoch="${3:-0}"
  [[ -n "$completion_marker" ]] || return 1
  response_file_is_fresh "$response_path" "$min_response_epoch" || return 1
  tail -n 5 "$response_path" 2>/dev/null |
    awk -v marker="$completion_marker" '$0 == marker { found = 1 } END { exit !found }'
}

strip_response_completion_marker() {
  local response_path="$1" completion_marker="$2" temporary
  [[ -f "$response_path" && -n "$completion_marker" ]] || return 1
  temporary="$(mktemp "$(dirname "$response_path")/.response-complete.XXXXXX")"
  if ! awk -v marker="$completion_marker" '$0 != marker { print }' "$response_path" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  mv -f "$temporary" "$response_path"
}

log_event() {
  local event="$1" provider="$2" session="$3" status="$4" detail="${5:-}"
  mkdir -p "$(dirname "$LOG_PATH")"
  printf '{"ts":"%s","event":"%s","provider":"%s","session":"%s","status":"%s","detail":"%s"}\n' \
    "$(date -Is)" "$(json_escape "$event")" "$(json_escape "$provider")" "$(json_escape "$session")" "$(json_escape "$status")" "$(json_escape "$detail")" >> "$LOG_PATH"
}

state_search_roots() {
  local provider="$1" project_slug="${2:-}"
  local root
  for root in "$STATE_ROOT" "$LEGACY_STATE_ROOT"; do
    [[ -d "$root" ]] || continue
    if [[ -n "$provider" && -n "$project_slug" ]]; then
      [[ -d "$root/$provider/$project_slug" ]] && printf '%s\n' "$root/$provider/$project_slug"
    elif [[ -n "$provider" ]]; then
      [[ -d "$root/$provider" ]] && printf '%s\n' "$root/$provider"
    elif [[ -n "$project_slug" ]]; then
      find "$root" -mindepth 2 -maxdepth 2 -type d -name "$project_slug" 2>/dev/null
    else
      printf '%s\n' "$root"
    fi
  done | sort -u
}

key_state_names() {
  local key="$1" key_id legacy
  key_id="$(key_id_from_key "$key")"
  legacy="$(legacy_key_slug_from_key "$key")"
  printf '%s.json\n' "$key_id"
  if [[ "$legacy" != "$key_id" ]]; then
    printf '%s.json\n' "$legacy"
  fi
}

find_state_files() {
  local provider="$1" key="${2:-}" all="${3:-false}" project_slug="${4:-}"
  local root name
  if [[ "$all" == "true" || -z "$key" ]]; then
    while IFS= read -r root; do
      [[ -n "$root" ]] || continue
      find "$root" -type f -name '*.json' 2>/dev/null
    done < <(state_search_roots "$provider" "$project_slug") | sort -u
  else
    while IFS= read -r root; do
      [[ -n "$root" ]] || continue
      while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        find "$root" -type f -name "$name" 2>/dev/null
      done < <(key_state_names "$key")
    done < <(state_search_roots "$provider" "$project_slug") | sort -u
  fi
}

read_state_files_into_array() {
  local array_name="$1" line
  shift
  # Bash 3.2 on macOS has no mapfile/readarray or namerefs.
  eval "$array_name=()"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    eval "$array_name+=(\"\$line\")"
  done < <(find_state_files "$@")
}

prefer_hashed_state_file_if_same_project() {
  local key="$1"
  shift
  local first_provider="" first_project="" file file_provider file_project preferred
  for file in "$@"; do
    file_provider="$(read_json_field "$file" provider)"
    file_project="$(read_json_field "$file" project_slug)"
    [[ -n "$file_provider" ]] || file_provider="$(basename "$(dirname "$(dirname "$file")")")"
    [[ -n "$file_project" ]] || file_project="$(basename "$(dirname "$file")")"
    if [[ -z "$first_provider" ]]; then
      first_provider="$file_provider"
      first_project="$file_project"
    elif [[ "$file_provider" != "$first_provider" || "$file_project" != "$first_project" ]]; then
      return 1
    fi
  done
  preferred="$(state_file_for "$first_provider" "$first_project" "$(key_id_from_key "$key")")"
  [[ -f "$preferred" ]] || return 1
  printf '%s\n' "$preferred"
}

project_slug_for_optional_cwd() {
  local cwd="$1" cwd_mode="$2"
  if [[ -n "$cwd" ]]; then
    project_slug_from_path "$(resolve_cwd "$cwd" "$cwd_mode")"
  fi
}

select_state_file_for_key() {
  local provider="$1" key="$2" cwd="$3" cwd_mode="$4" command_name="$5"
  local project_slug matches=()
  project_slug="$(project_slug_for_optional_cwd "$cwd" "$cwd_mode")"
  read_state_files_into_array matches "$provider" "$key" false "$project_slug"
  if (( ${#matches[@]} == 0 )); then
    die "no state file found for key: $key"
  fi
  if (( ${#matches[@]} > 1 )); then
    local preferred
    if preferred="$(prefer_hashed_state_file_if_same_project "$key" "${matches[@]}")"; then
      printf '%s\n' "$preferred"
      return
    fi
  fi
  if (( ${#matches[@]} > 1 )); then
    printf 'Ambiguous state files for --key %s:\n' "$key" >&2
    printf '  %s\n' "${matches[@]}" >&2
    die "$command_name needs a project selector; rerun with --cwd /path/to/project or use --all intentionally"
  fi
  printf '%s\n' "${matches[0]}"
}

selected_claude_launcher() {
  local launcher="${ASK_TMUX_CLAUDE_LAUNCHER:-cc-claude}"
  case "$launcher" in
    cc-claude|cc-deepseek) ;;
    *)
      printf 'ASK_TMUX_CLAUDE_LAUNCHER must be cc-claude or cc-deepseek (got: %s)\n' "$launcher" >&2
      return 1
      ;;
  esac
  if ! command -v "$launcher" >/dev/null 2>&1; then
    printf 'Claude launcher is not installed or executable: %s\n' "$launcher" >&2
    return 1
  fi
  command -v "$launcher"
}

validate_claude_model() {
  case "$1" in
    ""|opus|sonnet|claude-opus-5|claude-opus-4-8|claude-sonnet-5) return 0 ;;
    *)
      printf 'Unsupported Claude model: %s\n' "$1" >&2
      return 1
      ;;
  esac
}

validate_claude_effort() {
  case "$1" in
    ""|low|medium|high|xhigh|max) return 0 ;;
    *)
      printf 'Unsupported Claude effort: %s\n' "$1" >&2
      return 1
      ;;
  esac
}

preflight_claude_credentials() {
  local launcher
  [[ "$1" == "true" ]] && return
  launcher="$(selected_claude_launcher)" || die 'Claude provider launcher selection failed'
  "$launcher" --version >/dev/null || die "Claude provider preflight failed for $launcher"
}

provider_launch_command() {
  local provider="$1" stub="$2" requested_model="${3:-}" requested_effort="${4:-}" launch_env claude_launcher launcher_name
  if [[ -n "$requested_model" && "$provider" != "claude" ]]; then
    die "--model is supported only for the Claude provider"
  fi
  if [[ -n "$requested_effort" && "$provider" != "claude" ]]; then
    die "--effort is supported only for the Claude provider"
  fi
  if [[ "$stub" == "true" ]]; then
    printf "%s" "bash -lc 'printf \"ASK_TMUX_STUB_READY\\n\"; while IFS= read -r line; do printf \"ASK_TMUX_STUB_RECEIVED:%s\\n\" \"\$line\"; response_b64=\$(printf \"%s\" \"\$line\" | sed -n \"s/.*ASK_TMUX_RESPONSE_B64=\\([^ ]*\\).*/\\1/p\"); response=\"\"; if [ -n \"\$response_b64\" ]; then response=\$(printf \"%s\" \"\$response_b64\" | base64 -D 2>/dev/null || printf \"%s\" \"\$response_b64\" | base64 -d 2>/dev/null); fi; sentinel=\$(printf \"%s\" \"\$line\" | sed -n \"s/.*ASK_TMUX_SENTINEL=\\([^ ]*\\).*/\\1/p\"); completion=\$(printf \"%s\" \"\$line\" | sed -n \"s/.*ASK_TMUX_COMPLETION_MARKER=\\([^ ]*\\).*/\\1/p\"); if [ -n \"\$response\" ]; then mkdir -p \"\$(dirname \"\$response\")\"; printf \"Stub consultant response for: %s\\n\" \"\$line\" > \"\$response\"; if [ -n \"\$completion\" ]; then printf \"%s\\n\" \"\$completion\" >> \"\$response\"; fi; fi; if [ -n \"\$sentinel\" ]; then printf \"%s\\n\" \"\$sentinel\"; fi; done'"
    return
  fi
  launch_env="env PATH=$(shell_quote "$PATH") HOME=$(shell_quote "$HOME")"
  case "$provider" in
    claude)
      claude_launcher="$(selected_claude_launcher)" || die 'Claude provider launcher selection failed'
      launcher_name="$(basename "$claude_launcher")"
      if [[ -n "$requested_model" || -n "$requested_effort" ]]; then
        [[ "$launcher_name" == "cc-claude" ]] || die "--model and --effort are not supported with cc-deepseek; DeepSeek owns its model mapping"
        validate_claude_model "$requested_model" || die "Claude model validation failed"
        validate_claude_effort "$requested_effort" || die "Claude effort validation failed"
      fi
      printf '%s' "$launch_env bash -lc 'exec \"\$@\"' bash $(shell_quote "$claude_launcher")"
      [[ -n "$requested_model" ]] && printf ' --model %s' "$(shell_quote "$requested_model")"
      [[ -n "$requested_effort" ]] && printf ' --effort %s' "$(shell_quote "$requested_effort")"
      # Keep consultants independent from the owner's plugins, hooks, MCP
      # servers, memories, and auto-discovered instruction stack. Those
      # customizations can also add tens of thousands of tokens before the
      # explicit review packet is read.
      printf ' %s\n' "$CLAUDE_RUNTIME_FLAGS"
      ;;
    codex) printf '%s\n' "$launch_env codex --dangerously-bypass-approvals-and-sandbox" ;;
    *) die "unknown provider: $provider" ;;
  esac
}

write_limited_file_block() {
  local file="$1" size="$2"
  printf '```text\n'
  if (( size <= PACKET_LIMIT_BYTES )); then
    sed -n '1,2000p' "$file"
    printf '\n```\n\n'
  else
    LC_ALL=C head -c "$PACKET_LIMIT_BYTES" "$file"
    printf '\n```\n\n'
    printf '_Material truncated: embedded first %s of %s bytes. Inspect the path above for the full content._\n\n' "$PACKET_LIMIT_BYTES" "$size"
  fi
}

write_packet() {
  local packet="$1" provider="$2" task="$3" cwd="$4" owner_prompt="$5" response_path="$6" done_sentinel="$7" completion_marker="$8"
  shift 8
  local material size
  mkdir -p "$(dirname "$packet")"
  {
    printf '# Ask Tmux Consultant Packet\n\n'
    printf -- '- Provider: `%s`\n' "$provider"
    printf -- '- Task: `%s`\n' "$task"
    printf -- '- CWD: `%s`\n' "$cwd"
    printf -- '- Created: `%s`\n\n' "$(date -Is)"
    printf '## Owner Prompt\n\n%s\n\n' "$owner_prompt"
	    printf '## Safety Boundary\n\n'
    printf -- '- Default to read-only review/comment/suggest behavior.\n'
	    printf -- '- The only write allowed by default is writing the required response file named in this packet.\n'
	    printf -- '- Do not modify, create, delete, install, commit, push, submit jobs, or run destructive commands unless this packet explicitly grants a write scope.\n'
	    printf -- '- Do not execute shell commands unless the task is debug/verification and the packet explicitly asks for safe read-only probes.\n'
	    printf -- '- If edits or dangerous actions seem necessary, stop and recommend them instead.\n\n'
	    printf -- '- This is an instruction boundary, not an enforced sandbox. The owner launched the consultant CLI with elevated local permissions, so you must follow the packet scope exactly.\n\n'
    printf '## Output Contract\n\n'
    printf 'Return verdict, high/medium/low findings, missing verification, risks, concrete suggestions, recommended next actions, and any user questions.\n\n'
    printf '## Response File Contract\n\n'
    printf 'Write your full response to this absolute path:\n\n'
    printf '```text\n%s\n```\n\n' "$response_path"
    printf 'Do not wait until the entire response has been composed in memory. Start the response file early and update it in bounded passes, targeting no more than %s words per write/append operation. Preserve completed sections if a provider request is interrupted. Cover the complete owner prompt; bounded writes do not authorize narrowing or omitting scope.\n\n' "$RESPONSE_CHUNK_WORDS"
    printf 'When and only when the response is complete, append this exact marker on its own final line inside the response file:\n\n'
    printf '```text\n%s\n```\n\n' "$completion_marker"
    printf 'After writing the response file, print exactly this sentinel on its own final line in the pane:\n\n'
    printf '```text\n%s\n```\n\n' "$done_sentinel"
    printf '## Materials\n\n'
    if [[ "$#" -eq 0 ]]; then
      printf '_No material paths supplied._\n'
    fi
    for material in "$@"; do
      printf '### `%s`\n\n' "$material"
      if [[ "$material" == "-" ]]; then
        local stdin_tmp
        stdin_tmp="$(mktemp)"
        cat > "$stdin_tmp"
        size="$(wc -c < "$stdin_tmp" | tr -d ' ')"
        write_limited_file_block "$stdin_tmp" "$size"
        rm -f "$stdin_tmp"
      elif [[ -f "$material" ]]; then
        size="$(wc -c < "$material" | tr -d ' ')"
        printf 'Path: `%s`\n\n' "$(realpath -m "$material")"
        write_limited_file_block "$material" "$size"
      elif [[ -d "$material" ]]; then
        printf 'Directory: `%s`\n\n' "$(realpath -m "$material")"
        printf 'Top files:\n\n```text\n'
        find "$material" -maxdepth 2 -type f | sort | sed -n '1,200p'
        printf '\n```\n\n'
      else
        printf '_Missing path._\n\n'
      fi
    done
  } > "$packet"
}

text_contains_sentinel() {
  local text="$1" sentinel="$2" compact_text compact_sentinel
  if printf '%s' "$text" | rg -Fq "$sentinel"; then
    return 0
  fi
  compact_text="$(printf '%s' "$text" | tr -d '[:space:]')"
  compact_sentinel="$(printf '%s' "$sentinel" | tr -d '[:space:]')"
  printf '%s' "$compact_text" | rg -Fq "$compact_sentinel"
}

codex_update_prompt_choice() {
  local text="$1"
  if printf '%s' "$text" | rg -q '^([[:space:]]|›)*2\.[[:space:]]*Skip([[:space:]]|$)'; then
    printf '2\n'
    return 0
  fi
  if printf '%s' "$text" | rg -q '^([[:space:]]|›)*3\.[[:space:]]*Skip([[:space:]]|$)'; then
    printf '3\n'
    return 0
  fi
  return 1
}

codex_hooks_prompt_choice() {
  local text="$1"
  if printf '%s' "$text" | rg -q 'Hooks need review|Hooks can run outside the sandbox' && printf '%s' "$text" | rg -q '2\.[[:space:]]*Trust all and continue'; then
    printf '2\n'
    return 0
  fi
  return 1
}

codex_prompt_submit_region() {
  local text="$1" prompt_marker="$2" line found="false" region=""
  while IFS= read -r line; do
    if [[ "$line" == *"$prompt_marker"* || "$line" == *"[Pasted Content "*" chars]"* ]]; then
      found="true"
      region="$line"$'\n'
      continue
    fi
    if [[ "$found" == "true" ]]; then
      region="${region}${line}"$'\n'
    fi
  done < <(printf '%s\n' "$text")
  [[ "$found" == "true" ]] || return 1
  printf '%s' "$region"
}

codex_prompt_needs_second_submit() {
  local text="$1" prompt_marker="$2" region
  region="$(codex_prompt_submit_region "$text" "$prompt_marker")" || return 1
  if codex_text_shows_activity "$region"; then
    return 1
  fi
  return 0
}

codex_text_shows_activity() {
  local text="$1"
  printf '%s' "$text" | rg -q 'Working|Swooping|esc to interrupt|^[[:space:]]*(•|⏺|✻)'
}

codex_pane_is_ready() {
  local text="$1" recent latest_codex_screen
  recent="$(printf '%s\n' "$text" | tail -n 20)"

  # A working pane can retain a composer and model footer. Keep the activity
  # signals that unambiguously mean an in-flight response separate from the
  # benign MCP-startup marker that Codex leaves in an otherwise ready pane.
  if printf '%s' "$recent" | rg -q 'Working|Swooping|^[[:space:]]*(⏺|✻)'; then
    return 1
  fi

  # Capture only the newest banner. An older ready screen must not hide a
  # current model-loading screen, whose footer can already name a model.
  latest_codex_screen="$(printf '%s\n' "$text" | awk '
    /OpenAI Codex/ { screen = "" }
    { screen = screen $0 ORS }
    END { printf "%s", screen }
  ')"
  if printf '%s' "$latest_codex_screen" | rg -q 'model:[[:space:]]+loading([[:space:]]|$)'; then
    return 1
  fi

  # Legacy Codex releases used an empty composer or a complete startup banner.
  printf '%s' "$recent" | rg -q '(^|[[:space:]])(›|>)[[:space:]]*$|What can I help|Type /help|Ready' && return 0
  if printf '%s' "$latest_codex_screen" | rg -q 'OpenAI Codex' \
    && printf '%s' "$latest_codex_screen" | rg -q 'permissions:|YOLO mode' \
    && printf '%s' "$latest_codex_screen" | rg -q 'model:[[:space:]]+(gpt-[[:alnum:]._-]+|codex-[[:alnum:]._-]+)([[:space:]]+[^[:space:]]+)*[[:space:]]+/model to change' \
    && printf '%s' "$latest_codex_screen" | rg -q '^[[:space:]]*(gpt-[[:alnum:]._-]+|codex-[[:alnum:]._-]+)([[:space:]]+[^[:space:]]+)*[[:space:]]+·[[:space:]]+'; then
    return 0
  fi

  # Codex 0.144+ fills an idle composer with rotating placeholder text, for
  # example "› Write tests for @filename". Require an adjacent model/cwd
  # footer so numbered trust/update choices are not accepted as ready.
  if printf '%s' "$recent" | rg -q '^[[:space:]]*(›|>)[[:space:]]+[^[:space:]].*$' &&
     printf '%s' "$recent" | rg -q '^[[:space:]]*(gpt-[[:alnum:]._-]+|codex-[[:alnum:]._-]+).*·[[:space:]]+(~|/)'; then
    return 0
  fi
  return 1
}

send_prompt_to_pane() {
  local pane="$1" prompt="$2" provider="${3:-}" prompt_marker="${4:-$2}" buffer_name attempt text
  local failed_command failed_exit failed_stdout failed_stderr failed_kind failed_retryable
  TMUX_PROMPT_DELIVERY_PHASE="not_started"
  buffer_name="ask-tmux-send-$$-$RANDOM"
  tmux_control_command set-buffer -b "$buffer_name" -- "$prompt" || return 1
  TMUX_PROMPT_DELIVERY_PHASE="buffered"
  if ! tmux_control_command paste-buffer -d -b "$buffer_name" -t "$pane"; then
    failed_command="$TMUX_CONTROL_COMMAND"
    failed_exit="$TMUX_CONTROL_EXIT"
    failed_stdout="$TMUX_CONTROL_STDOUT"
    failed_stderr="$TMUX_CONTROL_STDERR"
    failed_kind="$TMUX_CONTROL_KIND"
    failed_retryable="$TMUX_CONTROL_RETRYABLE"
    tmux_control_command delete-buffer -b "$buffer_name" >/dev/null 2>&1 || true
    TMUX_CONTROL_COMMAND="$failed_command"
    TMUX_CONTROL_EXIT="$failed_exit"
    TMUX_CONTROL_STDOUT="$failed_stdout"
    TMUX_CONTROL_STDERR="$failed_stderr"
    TMUX_CONTROL_KIND="$failed_kind"
    TMUX_CONTROL_RETRYABLE="$failed_retryable"
    TMUX_PROMPT_DELIVERY_PHASE="paste_failed"
    return 1
  fi
  TMUX_PROMPT_DELIVERY_PHASE="pasted"
  sleep 0.3
  tmux_control_command send-keys -t "$pane" Enter || return 1
  TMUX_PROMPT_DELIVERY_PHASE="accepted"
  if [[ "$provider" == "codex" ]]; then
    for attempt in 1 2 3 4 5; do
      sleep 0.7
      if ! tmux_control_command capture-pane -J -t "$pane" -p -S "-80"; then
        TMUX_PROMPT_DELIVERY_PHASE="accepted_unconfirmed"
        return 2
      fi
      text="$TMUX_CONTROL_STDOUT"
      if codex_prompt_needs_second_submit "$text" "$prompt_marker"; then
        if ! tmux_control_command send-keys -t "$pane" Enter; then
          TMUX_PROMPT_DELIVERY_PHASE="accepted_unconfirmed"
          return 2
        fi
        break
      fi
      codex_text_shows_activity "$text" && break
    done
  fi
  TMUX_PROMPT_DELIVERY_PHASE="confirmed"
}

pane_is_ready() {
  local provider="$1" stub="$2" text="$3"
  if [[ "$stub" == "true" ]]; then
    printf '%s' "$text" | rg -q 'ASK_TMUX_STUB_READY'
    return
  fi
	case "$provider" in
	  claude)
	    printf '%s' "$text" | rg -q '(^|[[:space:]])(>|❯)[[:space:]]*$|bypass permissions on|What can I help|Type /help'
	    ;;
	  codex)
	    codex_pane_is_ready "$text"
	    ;;
    *)
      return 1
      ;;
  esac
}

wait_for_ready() {
  local provider="$1" stub="$2" session="$3" pane="$4" timeout="$5" auto_trust="$6"
  local start now text liveness_rc
  start="$(date +%s)"
  while true; do
    if tmux_session_liveness "$session"; then
      :
    else
      liveness_rc="$?"
      [[ "$liveness_rc" == "1" ]] && return 3
      return 5
    fi
    tmux_control_command capture-pane -J -t "$pane" -p -S "-120" || return 5
    text="$TMUX_CONTROL_STDOUT"
    if pane_is_ready "$provider" "$stub" "$text"; then
      return 0
    fi
    if [[ "$provider" == "codex" ]] && printf '%s' "$text" | rg -q 'Update available!.*->|Update now.*Skip|Skip until next version'; then
      local update_choice
      if update_choice="$(codex_update_prompt_choice "$text")"; then
        tmux_control_command send-keys -t "$pane" "$update_choice" Enter || return 5
        sleep 1
        continue
      fi
    fi
    if [[ "$provider" == "codex" ]] && printf '%s' "$text" | rg -q 'Hooks need review|Trust all and continue|Continue without trusting'; then
      local hooks_choice
      if [[ "$auto_trust" == "true" ]] && hooks_choice="$(codex_hooks_prompt_choice "$text")"; then
        tmux_control_command send-keys -t "$pane" "$hooks_choice" Enter || return 5
        sleep 1
        continue
      fi
      warn "consultant is waiting at a Codex hooks review prompt; attach and choose a trust option, or rerun with --auto-trust"
      return 2
    fi
    if [[ "$provider" == "codex" ]] && printf '%s' "$text" | rg -q 'Do you trust the contents of this directory|Yes, continue'; then
      if [[ "$auto_trust" == "true" ]]; then
        tmux_control_command send-keys -t "$pane" Enter || return 5
        sleep 1
        continue
      fi
      warn "consultant is waiting at a Codex workspace trust prompt; attach and confirm, or rerun with --auto-trust"
      return 2
    fi
    if printf '%s' "$text" | rg -q 'Quick safety check|Yes, I trust this folder|Enter to confirm'; then
      if [[ "$auto_trust" == "true" ]]; then
        tmux_control_command send-keys -t "$pane" Enter || return 5
        sleep 1
      else
        warn "consultant is waiting at a workspace trust prompt; attach and confirm, or rerun with --auto-trust"
        return 2
      fi
    fi
    now="$(date +%s)"
    if (( now - start >= timeout )); then
      warn "consultant pane did not become input-ready within ${timeout}s"
      return 1
    fi
    sleep 1
  done
}

claude_gateway_524_count() {
  local text="$1"
  printf '%s\n' "$text" | awk '
    function has_origin_timeout_marker(line) {
      return index(line, "origin_response_timeout") \
        || index(line, "Proxy Read Timeout") \
        || (index(line, "cloudflare_error") && index(line, "true"))
    }
    {
      if (index($0, "API Error: 524")) {
        pending_lines = 12
      }
      if (pending_lines > 0) {
        if (has_origin_timeout_marker($0)) {
          count++
          pending_lines = 0
          next
        }
        pending_lines--
      }
    }
    END { print count + 0 }
  '
}

wait_for_done() {
  local session="$1" pane="$2" sentinel="$3" response_path="$4" timeout="$5" min_response_epoch="${6:-0}" provider="${7:-}" completion_marker="${8:-}"
  local start now text saw_sentinel="false" initial_gateway_524_count current_gateway_524_count liveness_rc
  start="$(date +%s)"
  tmux_control_command capture-pane -J -t "$pane" -p -S "-2000" || return 5
  initial_gateway_524_count="$(claude_gateway_524_count "$TMUX_CONTROL_STDOUT")"
  while true; do
    if tmux_session_liveness "$session"; then
      :
    else
      liveness_rc="$?"
      [[ "$liveness_rc" == "1" ]] && return 1
      return 5
    fi
    tmux_control_command capture-pane -J -t "$pane" -p -S "-2000" || return 5
    text="$TMUX_CONTROL_STDOUT"
    # A complete durable response is stronger completion evidence than the
    # cosmetic pane sentinel. Claude can finish the file and lose only its
    # final terminal turn to a gateway timeout.
    if response_file_is_complete "$response_path" "$completion_marker" "$min_response_epoch"; then
      return 0
    fi
    if text_contains_sentinel "$text" "$sentinel"; then
      saw_sentinel="true"
      if [[ -z "$completion_marker" ]] && response_file_is_fresh "$response_path" "$min_response_epoch"; then
        return 0
      fi
    fi
    if [[ "$provider" == "claude" ]]; then
      current_gateway_524_count="$(claude_gateway_524_count "$text")"
      if (( current_gateway_524_count > initial_gateway_524_count )); then
        return 4
      fi
    fi
    now="$(date +%s)"
    if (( now - start >= timeout )); then
      [[ "$saw_sentinel" == "true" ]] && return 3
      return 2
    fi
    sleep 1
  done
}

WAIT_RECOVERY_RETRY_COUNT=0

wait_for_done_resilient() {
  local session="$1" pane="$2" sentinel="$3" response_path="$4" timeout="$5" min_response_epoch="$6" provider="$7" completion_marker="$8"
  local stub="$9" ready_timeout="${10}" auto_trust="${11}" response_token="${12}"
  local done_rc=0 retry_count=0 retry_prompt retry_delivery_status

  while true; do
    if wait_for_done "$session" "$pane" "$sentinel" "$response_path" "$timeout" "$min_response_epoch" "$provider" "$completion_marker"; then
      done_rc=0
    else
      done_rc="$?"
    fi
    [[ "$done_rc" == "0" ]] && break
    if [[ "$done_rc" != "4" || "$provider" != "claude" || "$retry_count" -ge "$CLAUDE_524_MAX_RETRIES" ]]; then
      break
    fi

    retry_count="$((retry_count + 1))"
    log_event "provider_gateway_timeout_524_retry" "$provider" "$session" "retrying" \
      "attempt=$retry_count max=$CLAUDE_524_MAX_RETRIES backoff=${CLAUDE_524_BACKOFF_SECONDS}s response=$response_path"
    info "provider_gateway_timeout_524 retry=$retry_count/$CLAUDE_524_MAX_RETRIES backoff_seconds=$CLAUDE_524_BACKOFF_SECONDS" >&2
    if (( CLAUDE_524_BACKOFF_SECONDS > 0 )); then
      sleep "$CLAUDE_524_BACKOFF_SECONDS"
    fi
    if ! wait_for_ready "$provider" "$stub" "$session" "$pane" "$ready_timeout" "$auto_trust"; then
      done_rc=4
      break
    fi

    retry_prompt="The preceding provider turn ended with gateway error 524. Resume this same task from the preserved session and any partial ASK_TMUX_RESPONSE file. Do not redo completed inspection or omit any requested scope. Continue the response in bounded passes, targeting no more than $RESPONSE_CHUNK_WORDS words per write/append operation. When the complete owner prompt has been covered, append $completion_marker on its own final line inside $response_token, then print $sentinel on its own final pane line."
    retry_delivery_status=0
    if send_prompt_to_pane "$pane" "$retry_prompt" "$provider" "$completion_marker"; then
      retry_delivery_status=0
    else
      retry_delivery_status="$?"
    fi
    if [[ "$retry_delivery_status" != "0" ]]; then
      done_rc=5
      break
    fi
  done

  WAIT_RECOVERY_RETRY_COUNT="$retry_count"
  return "$done_rc"
}

scope_check_status() {
  local scope_file="$1"
  sed -n 's/^STATUS:[[:space:]]*//p' "$scope_file" 2>/dev/null |
    sed -n '1p' |
    tr '[:lower:]' '[:upper:]'
}

SCOPE_CHECK_LAST_FILE=""

ensure_response_scope_complete() {
  local session="$1" pane="$2" provider="$3" response_path="$4" response_token="$5" response_marker="$6" packet="$7"
  local wait_timeout="$8" min_response_epoch="$9" stub="${10}" ready_timeout="${11}" auto_trust="${12}"
  local response_root response_base pass=0 revision_count=0 scope_file scope_marker scope_sentinel
  local scope_prompt scope_status revision_prompt delivery_rc wait_rc

  [[ "$provider" == "claude" ]] || return 0
  response_root="$(dirname "$response_path")"
  response_base="$(basename "$response_path" .md)"

  while true; do
    pass="$((pass + 1))"
    scope_file="$response_root/${response_base}.scope-$(printf '%02d' "$pass").md"
    scope_marker="<<<ASK_TMUX_SCOPE_COMPLETE:${pass}:$(date +%s):$$>>>"
    scope_sentinel="<<<ASK_TMUX_SCOPE_DONE:${pass}:$(date +%s):$$>>>"
    rm -f "$scope_file"
    SCOPE_CHECK_LAST_FILE="$scope_file"

    if ! wait_for_ready "$provider" "$stub" "$session" "$pane" "$ready_timeout" "$auto_trust"; then
      return 5
    fi
    scope_prompt="Perform a strict completeness audit of the consultant response. Read the original packet at $(shell_quote "$packet") and the response at $response_token. Enumerate every explicit deliverable, requested numbered item, section, constraint, and required decision in the owner prompt. Check that each is substantively answered in the actual file. Do not accept promises, forward references to nonexistent sections, headings without content, or a completion marker as evidence. Write only the audit to $(shell_quote "$scope_file") using exactly this protocol: first line ASK_TMUX_SCOPE_CHECK_V1; second line STATUS: COMPLETE or STATUS: INCOMPLETE; then REQUIRED, EVIDENCE, and MISSING sections with concrete mappings; final line $scope_marker. Print $scope_sentinel on its own final pane line. Mark COMPLETE only when nothing requested is missing."
    delivery_rc=0
    if send_prompt_to_pane "$pane" "$scope_prompt" "$provider" "$scope_marker"; then
      delivery_rc=0
    else
      delivery_rc="$?"
    fi
    [[ "$delivery_rc" == "0" ]] || return 5

    if wait_for_done_resilient "$session" "$pane" "$scope_sentinel" "$scope_file" "$wait_timeout" "$(date +%s)" "$provider" "$scope_marker" "$stub" "$ready_timeout" "$auto_trust" "$(shell_quote "$scope_file")"; then
      wait_rc=0
    else
      wait_rc="$?"
    fi
    [[ "$wait_rc" == "0" ]] || return "$wait_rc"
    strip_response_completion_marker "$scope_file" "$scope_marker" || true
    scope_status="$(scope_check_status "$scope_file")"
    if [[ "$scope_status" == "COMPLETE" ]]; then
      return 0
    fi

    if [[ "$revision_count" -ge "$SCOPE_MAX_REVISIONS" ]]; then
      return 6
    fi
    revision_count="$((revision_count + 1))"
    strip_response_completion_marker "$response_path" "$response_marker" || true
    if ! wait_for_ready "$provider" "$stub" "$session" "$pane" "$ready_timeout" "$auto_trust"; then
      return 5
    fi
    revision_prompt="The strict scope audit at $(shell_quote "$scope_file") found the response incomplete or malformed. Read that audit, the original packet at $(shell_quote "$packet"), and the existing response at $response_token. Preserve correct existing content, replace false forward references, and append or revise every missing substantive item. Do not narrow the owner prompt. Continue using bounded write/append operations, targeting no more than $RESPONSE_CHUNK_WORDS words each. When the entire owner prompt is genuinely covered, append $response_marker on its own final line inside $response_token and print the original completion sentinel only after the file is complete."
    delivery_rc=0
    if send_prompt_to_pane "$pane" "$revision_prompt" "$provider" "$response_marker"; then
      delivery_rc=0
    else
      delivery_rc="$?"
    fi
    [[ "$delivery_rc" == "0" ]] || return 5
    if wait_for_done_resilient "$session" "$pane" "<<<ASK_TMUX_REVISION_DONE:${revision_count}>>>" "$response_path" "$wait_timeout" "$min_response_epoch" "$provider" "$response_marker" "$stub" "$ready_timeout" "$auto_trust" "$response_token"; then
      wait_rc=0
    else
      wait_rc="$?"
    fi
    [[ "$wait_rc" == "0" ]] || return "$wait_rc"
  done
}

cmd_send() {
  local provider="" requested_model="" requested_effort="" claude_launcher="" key="" cwd="" cwd_mode="project" task="review" owner_prompt="" release_policy="manual" ttl="" fresh="false" replace="false" reuse="true" dry_run="false" stub="${ASK_TMUX_CONSULTANT_STUB:-false}" attach="false" wait="true" ready_timeout="$READY_TIMEOUT_SECONDS" wait_timeout="$WAIT_TIMEOUT_SECONDS" auto_trust="false"
  local materials=()
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --model) requested_model="$2"; shift 2 ;;
      --effort) requested_effort="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --cwd-mode) cwd_mode="$2"; shift 2 ;;
      --task) task="$2"; shift 2 ;;
      --prompt) owner_prompt="$2"; shift 2 ;;
      --materials|--material) materials+=("$2"); shift 2 ;;
      --fresh) fresh="true"; reuse="false"; shift ;;
      --replace) replace="true"; shift ;;
      --reuse) reuse="true"; shift ;;
      --release) release_policy="$2"; shift 2 ;;
      --ttl) ttl="$2"; shift 2 ;;
      --stub) stub="true"; shift ;;
      --wait) wait="true"; shift ;;
      --no-wait) wait="false"; shift ;;
      --wait-timeout) wait_timeout="$2"; shift 2 ;;
      --ready-timeout) ready_timeout="$2"; shift 2 ;;
      --auto-trust) auto_trust="true"; shift ;;
      --dry-run) dry_run="true"; shift ;;
      --attach) attach="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown send option: $1" ;;
    esac
  done
  [[ -n "$provider" ]] || die "--provider is required when not using a provider wrapper"
  [[ "$provider" == "claude" || "$provider" == "codex" ]] || die "provider must be claude or codex"
  if [[ -n "$requested_model" && "$provider" != "claude" ]]; then
    die "--model is supported only for the Claude provider"
  fi
  if [[ -n "$requested_effort" && "$provider" != "claude" ]]; then
    die "--effort is supported only for the Claude provider"
  fi
  if [[ "$provider" == "claude" ]]; then
    local claude_launcher_path
    claude_launcher_path="$(selected_claude_launcher)" || die 'Claude provider launcher selection failed'
    claude_launcher="$(basename "$claude_launcher_path")"
    if [[ "$claude_launcher" == "cc-claude" ]]; then
      requested_effort="${requested_effort:-$DEFAULT_CLAUDE_EFFORT}"
      validate_claude_model "$requested_model" || die "Claude model validation failed"
      validate_claude_effort "$requested_effort" || die "Claude effort validation failed"
    elif [[ -n "$requested_model" || -n "$requested_effort" ]]; then
      die "--model and --effort are not supported with cc-deepseek; DeepSeek owns its model mapping"
    fi
  fi
  owner_prompt="${owner_prompt:-$(template_prompt "$task")}"

  [[ "$ready_timeout" =~ ^[0-9]+$ ]] || die "--ready-timeout must be seconds"
  [[ "$wait_timeout" =~ ^[0-9]+$ ]] || die "--wait-timeout must be seconds"
  [[ "$CLAUDE_524_MAX_RETRIES" =~ ^[0-9]+$ ]] || die "ASK_TMUX_CLAUDE_524_MAX_RETRIES must be a non-negative integer"
  [[ "$CLAUDE_524_BACKOFF_SECONDS" =~ ^[0-9]+$ ]] || die "ASK_TMUX_CLAUDE_524_BACKOFF_SECONDS must be seconds"
  [[ "$RESPONSE_CHUNK_WORDS" =~ ^[1-9][0-9]*$ ]] || die "ASK_TMUX_RESPONSE_CHUNK_WORDS must be a positive integer"
  [[ "$SCOPE_MAX_REVISIONS" =~ ^[0-9]+$ ]] || die "ASK_TMUX_SCOPE_MAX_REVISIONS must be a non-negative integer"

  local resolved project_slug key_id session pane state_file lock_file project_artifact_root packet_root packet response_root response done_sentinel completion_marker launch_cmd short_prompt run_stamp
  resolved="$(resolve_cwd "$cwd" "$cwd_mode" "${materials[@]+"${materials[@]}"}")"
  project_slug="$(project_slug_from_path "$resolved")"
  key="${key:-$task}"
  key_id="$(key_id_from_key "$key")"
  session="ask-tmux-${provider}-${project_slug}-${key_id}"
  pane=""
  state_file="$(state_file_for "$provider" "$project_slug" "$key_id")"
  lock_file="${state_file}.lock"
  run_stamp="$(date +%Y%m%dT%H%M%S)-$$-$RANDOM"
  project_artifact_root="$resolved/$PROJECT_ARTIFACT_DIR"
  packet_root="$project_artifact_root/consultants/packets"
  packet="$packet_root/${run_stamp}-${provider}-${key_id}.md"
  response_root="$project_artifact_root/consultants/responses"
  response="$response_root/${run_stamp}-${provider}-${key_id}.md"
  done_sentinel="<<<ASK_TMUX_DONE:${provider}:${key_id}:$(date +%s):$$>>>"
  completion_marker="<<<ASK_TMUX_RESPONSE_COMPLETE:${provider}:${key_id}:$(date +%s):$$>>>"
  if [[ "$dry_run" == "true" ]]; then
    launch_cmd="$(provider_launch_command "$provider" "$stub" "$requested_model" "$requested_effort")"
    info "DRY_RUN provider=$provider"
    info "DRY_RUN cwd=$resolved"
    info "DRY_RUN project_slug=$project_slug"
    info "DRY_RUN key=$key"
    info "DRY_RUN key_id=$key_id"
	    info "DRY_RUN session=$session"
	    info "DRY_RUN state_file=$state_file"
	    info "DRY_RUN packet=$packet"
	    info "DRY_RUN response=$response"
	    info "DRY_RUN done_sentinel=$done_sentinel"
	    info "DRY_RUN completion_marker=$completion_marker"
	    info "DRY_RUN launch_command=$launch_cmd"
	    info "DRY_RUN claude_launcher=$claude_launcher"
	    info "DRY_RUN requested_model=$requested_model"
	    info "DRY_RUN claude_effort=$requested_effort"
	    info "DRY_RUN task=$task"
	    info "DRY_RUN prompt=$owner_prompt"
	    return
  fi

  local preflight_report preflight_kind preflight_retryable
  if ! preflight_report="$(tmux_preflight_json)"; then
    preflight_kind="$(preflight_json_field "$preflight_report" kind)"
    preflight_retryable="$(preflight_json_field "$preflight_report" retryable)"
    printf 'ASK_TMUX_OUTCOME=%s\n' "$preflight_kind" >&2
    printf 'ASK_TMUX_RETRYABLE=%s\n' "$preflight_retryable" >&2
    printf '%s\n' "$preflight_report" >&2
    die "tmux preflight blocked this send: $preflight_kind"
  fi

  if [[ "$provider" == "claude" ]]; then
    preflight_claude_credentials "$stub"
  fi
  launch_cmd="$(provider_launch_command "$provider" "$stub" "$requested_model" "$requested_effort")"

  mkdir -p "$(dirname "$state_file")"
  exec 9>"$lock_file"
  flock -w 2 9 || die "state is locked by another ask-tmux operation: $lock_file"

  if [[ -f "$state_file" ]]; then
    local old_busy old_session old_pane old_sentinel old_response old_started old_key old_model old_launcher old_effort now_epoch
    local old_liveness_status=1 old_pane_status=1 old_capture_text="" reconciliation_control_kind
    old_busy="$(read_json_bool "$state_file" busy)"
    old_session="$(read_json_field "$state_file" session_name)"
    old_pane="$(read_json_field "$state_file" pane_target)"
    if [[ -n "$old_session" ]]; then
      if tmux_session_liveness "$old_session"; then
        old_liveness_status=0
      else
        old_liveness_status="$?"
      fi
      if [[ "$old_liveness_status" == "2" ]]; then
        reconciliation_control_kind="$(runtime_tmux_outcome_kind)"
        fail_tmux_control "$reconciliation_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while reconciling consultant session state: $old_session"
      fi
      if [[ "$old_liveness_status" == "0" ]]; then
        if pane_target_for_session_checked "$old_session" "$old_pane"; then
          old_pane="$TMUX_RESOLVED_PANE"
        else
          old_pane_status="$?"
          if [[ "$old_pane_status" == "2" ]]; then
            reconciliation_control_kind="$(runtime_tmux_outcome_kind)"
            fail_tmux_control "$reconciliation_control_kind" "$TMUX_CONTROL_RETRYABLE" \
              "tmux control failed while resolving the recorded consultant pane: $old_session"
          fi
          old_pane=""
        fi
      fi
    fi
    old_sentinel="$(read_json_field "$state_file" done_sentinel)"
    old_response="$(read_json_field "$state_file" last_response)"
    old_started="$(read_json_number "$state_file" started_epoch)"
    old_key="$(read_json_field "$state_file" key)"
    [[ -n "$old_key" ]] || old_key="$key"
    old_model="$(read_json_field "$state_file" requested_model)"
    old_launcher="$(read_json_field "$state_file" claude_launcher)"
    old_effort="$(read_json_field "$state_file" claude_effort)"
    if [[ -n "$old_session" && "$old_liveness_status" == "0" ]]; then
      if [[ "$old_model" != "$requested_model" || "$old_launcher" != "$claude_launcher" || "$old_effort" != "$requested_effort" ]] &&
         [[ "$fresh" != "true" || "$replace" != "true" ]]; then
        die "live session launcher/model/effort differs from this request; use --fresh --replace"
      fi
    fi
    if [[ "$old_busy" == "true" && -n "$old_session" && -n "$old_sentinel" && "$old_liveness_status" == "0" ]]; then
      if [[ -n "$old_pane" ]]; then
        if capture_pane_text_checked "$old_pane" 240; then
          old_capture_text="$TMUX_CAPTURE_TEXT"
        else
          reconciliation_control_kind="$(runtime_tmux_outcome_kind)"
          fail_tmux_control "$reconciliation_control_kind" "$TMUX_CONTROL_RETRYABLE" \
            "tmux control failed while reconciling the recorded consultant response: $old_session"
        fi
      fi
      if [[ -n "$old_pane" ]] && printf '%s' "$old_capture_text" | rg -Fq "$old_sentinel" && response_file_is_fresh "$old_response" "${old_started:-0}"; then
        write_state "$state_file" "$provider" "$old_key" "$project_slug" "$old_session" "$old_pane" "$resolved" "$(read_json_field "$state_file" last_packet)" "live" "$(read_json_field "$state_file" release_policy)" "$(read_json_field "$state_file" ttl)" "$old_response" "false" "${old_started:-$(date +%s)}" "$(date +%s)" "$old_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
      else
        now_epoch="$(date +%s)"
        if [[ -n "$old_started" ]] && (( now_epoch - old_started > wait_timeout )); then
          die "consultant session appears stuck/busy for $((now_epoch - old_started))s: $old_session"
        fi
        die "consultant session is busy; wait for completion, inspect with capture/attach, or release it: $old_session"
      fi
    elif [[ "$old_busy" == "true" && -n "$old_session" && "$old_liveness_status" == "1" ]]; then
      log_event "missing_busy_session" "$provider" "$old_session" "missing" "$state_file"
    fi
  fi

  local session_liveness_status=1 replacement_status replacement_control_kind
  if tmux_session_liveness "$session"; then
    session_liveness_status=0
  else
    session_liveness_status="$?"
  fi
  if [[ "$session_liveness_status" == "2" ]]; then
    replacement_control_kind="$(runtime_tmux_outcome_kind)"
    fail_tmux_control "$replacement_control_kind" "$TMUX_CONTROL_RETRYABLE" \
      "tmux control failed while checking the requested consultant session: $session"
  fi
  if [[ "$session_liveness_status" == "0" ]]; then
    if [[ "$fresh" == "true" && "$replace" != "true" ]]; then
      die "live session exists for key '$key'; run release first or pass --replace"
    fi
    if [[ "$fresh" == "true" && "$replace" == "true" ]]; then
      if kill_tmux_session_checked "$session"; then
        replacement_status=0
      else
        replacement_status="$?"
      fi
      if [[ "$replacement_status" == "2" ]]; then
        replacement_control_kind="$(runtime_tmux_outcome_kind)"
        fail_tmux_control "$replacement_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while replacing consultant session: $session"
      fi
      log_event "replace" "$provider" "$session" "released" "$state_file"
      session_liveness_status=1
    elif [[ "$reuse" != "true" ]]; then
      die "live session exists and --reuse is disabled"
    fi
  fi

  write_packet "$packet" "$provider" "$task" "$resolved" "$owner_prompt" "$response" "$done_sentinel" "$completion_marker" "${materials[@]+"${materials[@]}"}"

  if [[ "$session_liveness_status" == "1" ]]; then
    if ! tmux_control_command new-session -d -s "$session" -c "$resolved" "$launch_cmd" 9>&-; then
      write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$(date +%s)" "$(date +%s)" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
      log_event "tmux_session_create_failed" "$provider" "$session" "failed" "control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
      fail_tmux_control "tmux_session_create_failed" "$TMUX_CONTROL_RETRYABLE" \
        "tmux could not create consultant session: $session"
    fi
    log_event "launch" "$provider" "$session" "live" "$launch_cmd"
    local launch_recorded_epoch
    launch_recorded_epoch="$(date +%s)"
    write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "" "$resolved" "$packet" "live" "$release_policy" "$ttl" "$response" "false" "$launch_recorded_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
  fi
  local pane_status=0 pane_failure_kind
  if pane_target_for_session_checked "$session"; then
    pane="$TMUX_RESOLVED_PANE"
  else
    pane_status="$?"
    if [[ "$pane_status" == "2" ]]; then
      pane_failure_kind="$(runtime_tmux_outcome_kind)"
      log_event "$pane_failure_kind" "$provider" "$session" "failed" "pane_resolution control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
      fail_tmux_control "$pane_failure_kind" "$TMUX_CONTROL_RETRYABLE" \
        "tmux control failed while resolving the consultant pane: $session"
    fi
    write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$(date +%s)" "$(date +%s)" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
    log_event "tmux_session_missing" "$provider" "$session" "failed" "no_addressable_pane"
    fail_outcome "tmux_session_missing" "true" \
      "consultant session has no addressable pane: $session"
  fi

  local ready_epoch
  ready_epoch="$(date +%s)"
  write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "live" "$release_policy" "$ttl" "$response" "false" "$ready_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"

  local ready_status=0
  if wait_for_ready "$provider" "$stub" "$session" "$pane" "$ready_timeout" "$auto_trust"; then
    ready_status=0
  else
    ready_status="$?"
    case "$ready_status" in
      1)
        write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$ready_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
        log_event "provider_not_ready" "$provider" "$session" "failed" "timeout=${ready_timeout}s"
        fail_outcome "provider_not_ready" "true" \
          "consultant did not become ready within ${ready_timeout}s; inspect with: tmux attach -t $session"
        ;;
      2)
        write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$ready_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
        log_event "provider_interaction_required" "$provider" "$session" "blocked" "trust_or_hooks_prompt"
        fail_outcome "provider_interaction_required" "true" \
          "consultant requires an explicit trust or hooks decision; inspect with: tmux attach -t $session"
        ;;
      3)
        write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$ready_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
        log_event "provider_process_exited" "$provider" "$session" "failed" "before_ready"
        fail_outcome "provider_process_exited" "true" \
          "consultant session exited before becoming ready: $session"
        ;;
      5)
        local readiness_control_kind
        readiness_control_kind="$(runtime_tmux_outcome_kind)"
        log_event "$readiness_control_kind" "$provider" "$session" "failed" "before_ready control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
        fail_tmux_control "$readiness_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while waiting for consultant readiness"
        ;;
      *)
        write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$ready_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
        log_event "provider_readiness_failed" "$provider" "$session" "failed" "exit=$ready_status"
        fail_outcome "provider_readiness_failed" "true" \
          "consultant readiness failed unexpectedly (exit $ready_status)"
        ;;
    esac
  fi

  local send_epoch
  send_epoch="$(date +%s)"
  rm -f "$response"
  write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "live" "$release_policy" "$ttl" "$response" "true" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
  local response_token response_b64 packet_token
  response_token="$(shell_quote "$response")"
  response_b64="$(printf '%s' "$response" | base64 | tr -d '\n')"
  packet_token="$(shell_quote "$packet")"
  short_prompt="ASK_TMUX_RESPONSE=$response_token ASK_TMUX_RESPONSE_B64=$response_b64 ASK_TMUX_SENTINEL=$done_sentinel ASK_TMUX_COMPLETION_MARKER=$completion_marker Read and follow this review packet: $packet_token . Task: $owner_prompt . Write the complete response incrementally to ASK_TMUX_RESPONSE in bounded passes, preserve partial work, append ASK_TMUX_COMPLETION_MARKER only after full coverage, then print only ASK_TMUX_SENTINEL on its own final line."
  local delivery_status=0
  if send_prompt_to_pane "$pane" "$short_prompt" "$provider" "ASK_TMUX_RESPONSE_B64=$response_b64"; then
    delivery_status=0
  else
    delivery_status="$?"
    if [[ "$delivery_status" == "2" ]]; then
      log_event "tmux_prompt_delivery_unconfirmed" "$provider" "$session" "busy" \
        "phase=$TMUX_PROMPT_DELIVERY_PHASE control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
      fail_tmux_control "tmux_prompt_delivery_unconfirmed" "false" \
        "the consultant prompt may have been accepted, but tmux could not confirm delivery; inspect the live pane before any retry: $pane"
    fi
    write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "$(date +%s)" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
    log_event "tmux_prompt_delivery_failed" "$provider" "$session" "failed" \
      "phase=$TMUX_PROMPT_DELIVERY_PHASE control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
    fail_tmux_control "tmux_prompt_delivery_failed" "$TMUX_CONTROL_RETRYABLE" \
      "tmux could not deliver the consultant prompt to pane: $pane"
  fi
  log_event "send" "$provider" "$session" "sent" "$packet"

  info "sent provider=$provider session=$session pane=$pane"
  info "cwd=$resolved"
  info "packet=$packet"
  info "response=$response"
  info "state=$state_file"

  if [[ "$wait" == "true" ]]; then
    local done_rc=0
    if wait_for_done_resilient "$session" "$pane" "$done_sentinel" "$response" "$wait_timeout" "$send_epoch" "$provider" "$completion_marker" "$stub" "$ready_timeout" "$auto_trust" "$response_token"; then
      done_rc=0
    else
      done_rc="$?"
    fi
    if [[ "$done_rc" == "0" && "$provider" == "claude" && "$stub" != "true" ]]; then
      if ensure_response_scope_complete "$session" "$pane" "$provider" "$response" "$response_token" "$completion_marker" "$packet" "$wait_timeout" "$send_epoch" "$stub" "$ready_timeout" "$auto_trust"; then
        done_rc=0
      else
        done_rc="$?"
      fi
    fi

    if [[ "$done_rc" == "0" ]]; then
      strip_response_completion_marker "$response" "$completion_marker" || true
      write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "live" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "$(date +%s)" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
      log_event "done" "$provider" "$session" "complete" "$response"
      info "done_sentinel=$done_sentinel"
      info "response_file=$response"
      printf '%s\n' '--- response ---'
      sed -n '1,2000p' "$response"
    else
      case "$done_rc" in
        1)
          write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
          log_event "provider_process_exited" "$provider" "$session" "failed" "$response"
          fail_outcome "provider_process_exited" "true" \
            "consultant session exited before done sentinel"
          ;;
        2)
          write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "live" "$release_policy" "$ttl" "$response" "true" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
          log_event "provider_completion_timeout" "$provider" "$session" "busy" "$response"
          fail_outcome "provider_completion_timeout" "true" \
            "timed out waiting ${wait_timeout}s for done sentinel; inspect with capture/attach"
          ;;
        3)
          write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
          log_event "provider_response_missing" "$provider" "$session" "failed" "$response"
          fail_outcome "provider_response_missing" "false" \
            "done sentinel appeared but response file is missing: $response"
          ;;
        4)
          write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
          log_event "provider_gateway_timeout_524" "$provider" "$session" "failed" "$response"
          fail_outcome "provider_gateway_timeout_524" "true" \
            "Claude provider gateway returned API Error 524 and exhausted $CLAUDE_524_MAX_RETRIES resumable attempt(s). Partial response work was preserved at: $response. Increasing --wait-timeout does not change the upstream 120-second limit; retry this same key to resume, or use a provider route with a longer streaming timeout."
          ;;
        5)
          local completion_control_kind
          completion_control_kind="$(runtime_tmux_outcome_kind)"
          log_event "$completion_control_kind" "$provider" "$session" "failed" "during_completion control_kind=$TMUX_CONTROL_KIND exit=$TMUX_CONTROL_EXIT"
          fail_tmux_control "$completion_control_kind" "$TMUX_CONTROL_RETRYABLE" \
            "tmux control failed while waiting for consultant completion"
          ;;
        6)
          write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "failed" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
          log_event "provider_scope_incomplete" "$provider" "$session" "failed" "$SCOPE_CHECK_LAST_FILE"
          fail_outcome "provider_scope_incomplete" "true" \
            "Claude exhausted $SCOPE_MAX_REVISIONS scope-completion revision(s). The response and last strict scope audit were preserved: response=$response audit=$SCOPE_CHECK_LAST_FILE"
          ;;
        *)
          die "unexpected wait failure: $done_rc"
          ;;
      esac
    fi
  else
    info "done_sentinel=$done_sentinel"
    info "no_wait=true"
  fi

  case "$release_policy" in
    now)
      local release_now_status release_now_control_kind
      if kill_tmux_session_checked "$session"; then
        release_now_status=0
      else
        release_now_status="$?"
      fi
      if [[ "$release_now_status" == "2" ]]; then
        release_now_control_kind="$(runtime_tmux_outcome_kind)"
        fail_tmux_control "$release_now_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while applying release policy now: $session"
      fi
      write_state "$state_file" "$provider" "$key" "$project_slug" "$session" "$pane" "$resolved" "$packet" "released" "$release_policy" "$ttl" "$response" "false" "$send_epoch" "$(date +%s)" "$done_sentinel" "$requested_model" "$claude_launcher" "$requested_effort"
      log_event "release_now" "$provider" "$session" "released" "$state_file"
      info "released session=$session"
      ;;
    manual|ttl) ;;
    *) warn "unknown release policy '$release_policy'; leaving session live" ;;
  esac

  flock -u 9 || true
  exec 9>&-

  if [[ "$attach" == "true" ]]; then
    attach_tmux_session "$session" "attach_command"
  fi
}

cmd_status() {
  local provider="" key="" all="false" cwd="" cwd_mode="project"
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --cwd-mode) cwd_mode="$2"; shift 2 ;;
      --all) all="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown status option: $1" ;;
    esac
  done
  local project_filter file session status last packet response busy completed sentinel pane started
  local liveness_status pane_status capture_text status_control_kind
  project_filter="$(project_slug_for_optional_cwd "$cwd" "$cwd_mode")"
  for file in $(find_state_files "$provider" "$key" "$all" "$project_filter"); do
    session="$(read_json_field "$file" session_name)"
    packet="$(read_json_field "$file" last_packet)"
    response="$(read_json_field "$file" last_response)"
    busy="$(read_json_bool "$file" busy)"
    completed="$(read_json_number "$file" completed_epoch)"
    sentinel="$(read_json_field "$file" done_sentinel)"
    pane="$(read_json_field "$file" pane_target)"
    started="$(read_json_number "$file" started_epoch)"
    last="$(read_json_number "$file" last_used_epoch)"
    liveness_status=1
    if [[ -n "$session" ]]; then
      if tmux_session_liveness "$session"; then
        liveness_status=0
      else
        liveness_status="$?"
      fi
      if [[ "$liveness_status" == "2" ]]; then
        status_control_kind="$(runtime_tmux_outcome_kind)"
        fail_tmux_control "$status_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while checking consultant status: $session"
      fi
    fi
    if [[ -n "$session" && "$liveness_status" == "0" ]]; then
      if pane_target_for_session_checked "$session" "$pane"; then
        pane="$TMUX_RESOLVED_PANE"
      else
        pane_status="$?"
        if [[ "$pane_status" == "2" ]]; then
          status_control_kind="$(runtime_tmux_outcome_kind)"
          fail_tmux_control "$status_control_kind" "$TMUX_CONTROL_RETRYABLE" \
            "tmux control failed while resolving consultant status pane: $session"
        fi
        pane=""
      fi
      if [[ "$busy" == "true" ]]; then
        capture_text=""
        if [[ -n "$pane" && -n "$sentinel" && -n "$response" ]]; then
          if capture_pane_text_checked "$pane" 240; then
            capture_text="$TMUX_CAPTURE_TEXT"
          else
            status_control_kind="$(runtime_tmux_outcome_kind)"
            fail_tmux_control "$status_control_kind" "$TMUX_CONTROL_RETRYABLE" \
              "tmux control failed while capturing consultant status: $session"
          fi
        fi
        if [[ -n "$pane" && -n "$sentinel" && -n "$response" ]] && printf '%s' "$capture_text" | rg -Fq "$sentinel" && response_file_is_fresh "$response" "${started:-0}"; then
          local provider_name key_name project_slug cwd release_policy ttl now_epoch
          provider_name="$(read_json_field "$file" provider)"
          key_name="$(read_json_field "$file" key)"
          [[ -n "$key_name" ]] || key_name="$(basename "$file" .json)"
          project_slug="$(read_json_field "$file" project_slug)"
          cwd="$(read_json_field "$file" cwd)"
          release_policy="$(read_json_field "$file" release_policy)"
          ttl="$(read_json_field "$file" ttl)"
          now_epoch="$(date +%s)"
          exec 9>"${file}.lock"
          if flock -w 2 9; then
            write_state "$file" "${provider_name:-$provider}" "$key_name" "${project_slug:-unknown}" "$session" "$pane" "${cwd:-$PWD}" "$packet" "live" "${release_policy:-manual}" "$ttl" "$response" "false" "${started:-$now_epoch}" "$now_epoch" "$sentinel"
            flock -u 9 || true
            busy="false"
            completed="$now_epoch"
            last="$now_epoch"
            status="live"
          else
            status="busy"
          fi
        else
          status="busy"
        fi
      else
        status="live"
      fi
    else
      local provider_name key_name project_slug cwd release_policy ttl started now_epoch
      status="$(read_json_field "$file" status)"
      if [[ "$status" == "live" || "$busy" == "true" ]]; then
        provider_name="$(read_json_field "$file" provider)"
        key_name="$(read_json_field "$file" key)"
        [[ -n "$key_name" ]] || key_name="$(basename "$file" .json)"
        project_slug="$(read_json_field "$file" project_slug)"
        cwd="$(read_json_field "$file" cwd)"
        release_policy="$(read_json_field "$file" release_policy)"
        ttl="$(read_json_field "$file" ttl)"
        started="$(read_json_number "$file" started_epoch)"
        now_epoch="$(date +%s)"
        exec 9>"${file}.lock"
        if flock -w 2 9; then
          write_state "$file" "${provider_name:-$provider}" "$key_name" "${project_slug:-unknown}" "$session" "${pane:-}" "${cwd:-$PWD}" "$packet" "missing" "${release_policy:-manual}" "$ttl" "$response" "false" "${started:-$now_epoch}" "" "$sentinel"
          flock -u 9 || true
          busy="false"
          last="$now_epoch"
        fi
        status="missing"
      fi
    fi
    printf '%s\t%s\tlast=%s\tcompleted=%s\tresponse=%s\tpacket=%s\tstate=%s\n' "$status" "$session" "$last" "${completed:-null}" "$response" "$packet" "$file"
  done
}

cmd_capture() {
  local provider="" key="" lines="240" artifact="false" cwd="" cwd_mode="project"
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --cwd-mode) cwd_mode="$2"; shift 2 ;;
      --lines) lines="$2"; shift 2 ;;
      --artifact) artifact="true"; shift ;;
      *) die "unknown capture option: $1" ;;
    esac
  done
  [[ -n "$key" ]] || die "--key is required for capture"
  local file session pane out artifact_file liveness_status pane_status capture_control_kind
  file="$(select_state_file_for_key "$provider" "$key" "$cwd" "$cwd_mode" "capture")"
  session="$(read_json_field "$file" session_name)"
  pane="$(read_json_field "$file" pane_target)"
  if tmux_session_liveness "$session"; then
    :
  else
    liveness_status="$?"
    if [[ "$liveness_status" == "1" ]]; then
      die "session is not live: $session"
    fi
    capture_control_kind="$(runtime_tmux_outcome_kind)"
    fail_tmux_control "$capture_control_kind" "$TMUX_CONTROL_RETRYABLE" \
      "tmux control failed while checking capture target: $session"
  fi
  if pane_target_for_session_checked "$session" "$pane"; then
    pane="$TMUX_RESOLVED_PANE"
  else
    pane_status="$?"
    if [[ "$pane_status" == "2" ]]; then
      capture_control_kind="$(runtime_tmux_outcome_kind)"
      fail_tmux_control "$capture_control_kind" "$TMUX_CONTROL_RETRYABLE" \
        "tmux control failed while resolving capture pane: $session"
    fi
    fail_outcome "tmux_pane_missing" "true" \
      "consultant session has no addressable pane: $session"
  fi
  if capture_pane_text_checked "$pane" "$lines"; then
    out="$TMUX_CAPTURE_TEXT"
  else
    capture_control_kind="$(runtime_tmux_outcome_kind)"
    fail_tmux_control "$capture_control_kind" "$TMUX_CONTROL_RETRYABLE" \
      "tmux control failed while capturing consultant pane: $pane"
  fi
  if [[ "$artifact" == "true" ]]; then
    mkdir -p "$ARTIFACT_ROOT"
    artifact_file="$ARTIFACT_ROOT/$(date +%Y%m%dT%H%M%S)-${session}.txt"
    printf '%s\n' "$out" > "$artifact_file"
    info "artifact=$artifact_file"
  fi
  printf '%s\n' "$out"
}

cmd_attach() {
  local provider="" key="" cwd="" cwd_mode="project"
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --cwd-mode) cwd_mode="$2"; shift 2 ;;
      *) die "unknown attach option: $1" ;;
    esac
  done
  [[ -n "$key" ]] || die "--key is required for attach"
  local file session liveness_status attach_control_kind
  file="$(select_state_file_for_key "$provider" "$key" "$cwd" "$cwd_mode" "attach")"
  session="$(read_json_field "$file" session_name)"
  if tmux_session_liveness "$session"; then
    :
  else
    liveness_status="$?"
    if [[ "$liveness_status" == "1" ]]; then
      die "session is not live: $session"
    fi
    attach_control_kind="$(runtime_tmux_outcome_kind)"
    fail_tmux_control "$attach_control_kind" "$TMUX_CONTROL_RETRYABLE" \
      "tmux control failed while checking attach target: $session"
  fi
  attach_tmux_session "$session"
}

cmd_release() {
  local provider="" key="" all="false" cwd="" cwd_mode="project"
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --cwd-mode) cwd_mode="$2"; shift 2 ;;
      --all) all="true"; shift ;;
      *) die "unknown release option: $1" ;;
    esac
  done
  [[ "$all" == "true" || -n "$key" ]] || die "release requires --key or --all"
  local project_filter preferred files=() file session pane packet state_cwd project_slug response sentinel key_name provider_name release_policy ttl started
  local release_status release_control_kind
  project_filter="$(project_slug_for_optional_cwd "$cwd" "$cwd_mode")"
  if [[ "$all" == "true" ]]; then
    read_state_files_into_array files "$provider" "" true "$project_filter"
  else
    read_state_files_into_array files "$provider" "$key" false "$project_filter"
    if (( ${#files[@]} == 0 )); then
      die "no state file found for key: $key"
    fi
    if (( ${#files[@]} > 1 )); then
      if preferred="$(prefer_hashed_state_file_if_same_project "$key" "${files[@]}")"; then
        files=("$preferred")
      else
      printf 'Ambiguous state files for --key %s:\n' "$key" >&2
      printf '  %s\n' "${files[@]}" >&2
      die "release needs a project selector; rerun with --cwd /path/to/project or use --all intentionally"
      fi
    fi
  fi
  for file in "${files[@]}"; do
    exec 9>"${file}.lock"
    flock -w 2 9 || die "state is locked by another ask-tmux operation: ${file}.lock"
    session="$(read_json_field "$file" session_name)"
    pane="$(read_json_field "$file" pane_target)"
    packet="$(read_json_field "$file" last_packet)"
    state_cwd="$(read_json_field "$file" cwd)"
    project_slug="$(read_json_field "$file" project_slug)"
    response="$(read_json_field "$file" last_response)"
    sentinel="$(read_json_field "$file" done_sentinel)"
    key_name="$(read_json_field "$file" key)"
    [[ -n "$key_name" ]] || key_name="$(basename "$file" .json)"
    provider_name="${provider:-$(read_json_field "$file" provider)}"
    release_policy="$(read_json_field "$file" release_policy)"
    ttl="$(read_json_field "$file" ttl)"
    started="$(read_json_number "$file" started_epoch)"
    if [[ -n "$session" ]]; then
      if kill_tmux_session_checked "$session"; then
        release_status=0
      else
        release_status="$?"
      fi
      if [[ "$release_status" == "2" ]]; then
        release_control_kind="$(runtime_tmux_outcome_kind)"
        fail_tmux_control "$release_control_kind" "$TMUX_CONTROL_RETRYABLE" \
          "tmux control failed while releasing consultant session: $session"
      fi
      info "released session=$session"
      write_state "$file" "$provider_name" "$key_name" "${project_slug:-unknown}" "$session" "$pane" "${state_cwd:-$PWD}" "$packet" "released" "${release_policy:-manual}" "$ttl" "$response" "false" "${started:-$(date +%s)}" "$(date +%s)" "$sentinel"
      log_event "release" "$provider_name" "$session" "released" "$file"
    fi
    flock -u 9 || true
  done
}

cmd_cleanup() {
  local provider="" stale_after="24h" now cutoff file last session pane packet cwd project_slug key_name busy
  local cleanup_status cleanup_control_kind
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --stale-after) stale_after="$2"; shift 2 ;;
      *) die "unknown cleanup option: $1" ;;
    esac
  done
  now="$(date +%s)"
  cutoff="$(( now - $(duration_to_seconds "$stale_after") ))"
  for file in $(find_state_files "$provider" "" true); do
    last="$(read_json_number "$file" last_used_epoch)"
    [[ -n "$last" ]] || continue
    if (( last < cutoff )); then
      exec 9>"${file}.lock"
      flock -w 2 9 || die "state is locked by another ask-tmux operation: ${file}.lock"
      busy="$(read_json_bool "$file" busy)"
      session="$(read_json_field "$file" session_name)"
      pane="$(read_json_field "$file" pane_target)"
      packet="$(read_json_field "$file" last_packet)"
      cwd="$(read_json_field "$file" cwd)"
      project_slug="$(read_json_field "$file" project_slug)"
      key_name="$(read_json_field "$file" key)"
      [[ -n "$key_name" ]] || key_name="$(basename "$file" .json)"
      local response sentinel started provider_name
      response="$(read_json_field "$file" last_response)"
      sentinel="$(read_json_field "$file" done_sentinel)"
      started="$(read_json_number "$file" started_epoch)"
      provider_name="${provider:-$(read_json_field "$file" provider)}"
      if [[ "$busy" == "true" ]]; then
        if tmux_session_liveness "$session"; then
          info "skip busy stale live session state=$file"
          flock -u 9 || true
          continue
        else
          cleanup_status="$?"
        fi
        if [[ "$cleanup_status" == "2" ]]; then
          cleanup_control_kind="$(runtime_tmux_outcome_kind)"
          fail_tmux_control "$cleanup_control_kind" "$TMUX_CONTROL_RETRYABLE" \
            "tmux control failed while checking stale busy session: $session"
        fi
      else
        if kill_tmux_session_checked "$session"; then
          cleanup_status=0
        else
          cleanup_status="$?"
        fi
        if [[ "$cleanup_status" == "2" ]]; then
          cleanup_control_kind="$(runtime_tmux_outcome_kind)"
          fail_tmux_control "$cleanup_control_kind" "$TMUX_CONTROL_RETRYABLE" \
            "tmux control failed while cleaning stale consultant session: $session"
        fi
      fi
      write_state "$file" "$provider_name" "$key_name" "${project_slug:-unknown}" "$session" "$pane" "${cwd:-$PWD}" "$packet" "released" "ttl" "$stale_after" "$response" "false" "${started:-$(date +%s)}" "$(date +%s)" "$sentinel"
      log_event "cleanup" "$provider_name" "$session" "released" "$file"
      info "cleaned stale session=$session"
      flock -u 9 || true
    fi
  done
}

cmd_preflight() {
  local json_output="false" provider="" report probe_status kind
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_output="true"; shift ;;
      --provider) provider="$2"; shift 2 ;;
      *) die "unknown preflight option: $1" ;;
    esac
  done
  if [[ -n "$provider" && "$provider" != "claude" && "$provider" != "codex" ]]; then
    die "provider must be claude or codex"
  fi
  if report="$(tmux_preflight_json)"; then
    probe_status=0
  else
    probe_status=$?
  fi
  if [[ "$json_output" == "true" ]]; then
    printf '%s\n' "$report"
  else
    kind="$(preflight_json_field "$report" kind)"
    if [[ "$probe_status" == "0" ]]; then
      info "PASS tmux_control=$kind"
    else
      info "FAIL tmux_control=$kind"
      info "tmux_stderr=$(preflight_json_field "$report" stderr)"
    fi
  fi
  return "$probe_status"
}

cmd_doctor() {
  local provider="" failed=0 tmux_report tmux_status tmux_kind tmux_version
  provider="$(invoked_provider)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done
	  info "ask-tmux-consultant version=$VERSION"
    if tmux_report="$(tmux_preflight_json)"; then
      tmux_status=0
    else
      tmux_status=$?
    fi
    tmux_kind="$(preflight_json_field "$tmux_report" kind)"
    tmux_version="$(preflight_json_field "$tmux_report" tmux.version)"
    if [[ "$tmux_status" == "0" ]]; then
      info "PASS tmux_control=$tmux_kind"
    else
      info "FAIL tmux_control=$tmux_kind"
      failed=1
    fi
    [[ -n "$tmux_version" ]] && info "INFO tmux_version=$tmux_version"
	  if [[ "${ASK_TMUX_RG_FALLBACK:-}" == "grep" ]]; then info "PASS rg=fallback-grep"; elif command -v rg >/dev/null; then info "PASS rg=$(command -v rg)"; else info "FAIL rg missing"; failed=1; fi
	  if command -v flock >/dev/null; then info "PASS flock=$(command -v flock)"; else info "FAIL flock missing"; failed=1; fi
	  if command -v python3 >/dev/null; then info "PASS python3=$(command -v python3)"; else info "FAIL python3 missing"; failed=1; fi
	  mkdir -p "$STATE_ROOT" "$ARTIFACT_ROOT" 2>/dev/null || true
	  if [[ -w "$STATE_ROOT" ]]; then info "PASS state_root=$STATE_ROOT"; else info "FAIL state_root_not_writable=$STATE_ROOT"; failed=1; fi
	  for p in ${provider:-claude codex}; do
	    if command -v "$p" >/dev/null; then info "PASS ${p}_cli=$(command -v "$p")"; else info "FAIL ${p}_cli missing"; failed=1; fi
	    if [[ "$p" == "claude" ]]; then
      if launcher="$(selected_claude_launcher)"; then
        info "PASS ${p}_launch=${launcher} ${CLAUDE_RUNTIME_FLAGS}"
        if claude-provider-doctor --check-update >/dev/null 2>&1; then info "PASS ${p}_provider_doctor"; else info "FAIL ${p}_provider_doctor"; failed=1; fi
      else
        info "FAIL ${p}_launcher"; failed=1
      fi
	    else
	      info "PASS ${p}_launch=codex --dangerously-bypass-approvals-and-sandbox"
	    fi
    if command -v "${p}-yolo" >/dev/null; then info "PASS ${p}_yolo=$(command -v "${p}-yolo")"; else info "INFO ${p}_yolo_not_required"; fi
	  done
  return "$failed"
}

main() {
  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 2; }
  shift || true
  case "$command" in
    send) cmd_send "$@" ;;
    status) cmd_status "$@" ;;
    capture) cmd_capture "$@" ;;
    attach) cmd_attach "$@" ;;
    release) cmd_release "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    gc) cmd_cleanup "$@" ;;
    preflight) cmd_preflight "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
